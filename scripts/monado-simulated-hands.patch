+DEBUG_GET_ONCE_BOOL_OPTION(simulated_hands, "SIMULATED_HANDS", false)
+
+/*!
+ * Simulated finger tracking (SIMULATED_HANDS=1): Index-knuckles style
+ * joints from curls that cycle through open and closed, a finger at a time,
+ * so an app's hand-tracking path can be tested without hardware.
+ */
+static xrt_result_t
+simulated_device_get_hand_tracking(struct xrt_device *xdev,
+                                   enum xrt_input_name name,
+                                   int64_t at_timestamp_ns,
+                                   struct xrt_hand_joint_set *out_value,
+                                   int64_t *out_timestamp_ns)
+{
+	struct simulated_device *sd = simulated_device(xdev);
+	if (name != XRT_INPUT_HT_CONFORMING_LEFT && name != XRT_INPUT_HT_CONFORMING_RIGHT) {
+		return XRT_ERROR_INPUT_UNSUPPORTED;
+	}
+	double t = (double)at_timestamp_ns / 1e9;
+	struct u_hand_tracking_curl_values values = {
+	    .little = (float)(0.5 + 0.5 * sin(t * 1.1 + 2.0)),
+	    .ring = (float)(0.5 + 0.5 * sin(t * 1.1 + 1.5)),
+	    .middle = (float)(0.5 + 0.5 * sin(t * 1.1 + 1.0)),
+	    .index = (float)(0.5 + 0.5 * sin(t * 1.1 + 0.5)),
+	    .thumb = (float)(0.5 + 0.5 * sin(t * 1.1)),
+	};
+	struct xrt_space_relation rel = {0};
+	rel.pose = sd->center;
+	rel.relation_flags = (enum xrt_space_relation_flags)(
+	    XRT_SPACE_RELATION_ORIENTATION_VALID_BIT | XRT_SPACE_RELATION_POSITION_VALID_BIT |
+	    XRT_SPACE_RELATION_ORIENTATION_TRACKED_BIT | XRT_SPACE_RELATION_POSITION_TRACKED_BIT);
+	enum xrt_hand hand = name == XRT_INPUT_HT_CONFORMING_LEFT ? XRT_HAND_LEFT : XRT_HAND_RIGHT;
+	u_hand_sim_simulate_for_valve_index_knuckles(&values, hand, &rel, out_value);
+	out_value->hand_pose = rel;
+	out_value->is_active = sd->active;
+	*out_timestamp_ns = at_timestamp_ns;
+	return XRT_SUCCESS;
+}
+
 /*
