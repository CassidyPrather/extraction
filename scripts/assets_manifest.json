  "terrain": {
    "_about": "Layer order is fixed by assets/shaders/terrain.wgsl and src/render/terrain_material.rs. 'repeat' tiles the source NxN inside the layer so its real-world scale matches the shader's tiling (3 m, rock 5 m). Grading keys as in 'materials'.",
    "size": 1024,
    "layers": [
      {
        "name": "grass",
        "source": "ph:grass_ground",
        "note": "2.5 m scan of tired olive-brown meadow grass",
        "tint": [
          0.9,
          1.0,
          0.85
        ],
        "brightness": 0.85
      },
      {
        "name": "forest_floor",
        "source": "ph:forest_leaves_02",
        "note": "3 m: moss, needles, sticks, leaf litter",
        "saturation": 0.8,
        "brightness": 0.6
      },
      {
        "name": "mud",
        "source": "ph:mud_forest",
        "note": "2.3 m dark wet forest mud",
        "brightness": 1.4
      },
      {
        "name": "rock",
        "source": "acg:Rock045",
        "repeat": 2,
        "note": "2.4 m grey lichen cliff, repeated 2x2 -> 4.8 m"
      },
      {
        "name": "gravel",
        "source": "ph:rocks_ground_09",
        "note": "3 m crushed grey aggregate"
      },
      {
        "name": "asphalt",
        "source": "acg:Asphalt021",
        "note": "1.85 m old asphalt with alligator cracking"
      },
      {
        "name": "dirt_road",
        "source": "ph:dry_mud_field_001",
        "note": "3 m compacted dirt track"
      }
    ]
  },
  "materials": {
