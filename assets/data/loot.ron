        "workshop": (rolls: (2, 4), entries: [
            Table(name: "tools", weight: 4.0),
            Item(id: "scrap_metal", weight: 3.0),
            Item(id: "electronics", weight: 1.5),
            Item(id: "polymer", weight: 1.0),
            Item(id: "fuel_can", weight: 0.4),
            Item(id: "bolt", weight: 2.0),
            Item(id: "powder", weight: 0.8),
            Item(id: "brass", weight: 0.6),
            // A servo off something someone took apart.
            Item(id: "servo", weight: 0.3, condition: (0.3, 0.9)),
            Nothing(weight: 2.0),
        ]),
        "medical": (rolls: (1, 2), entries: [
            Item(id: "field_dressing", weight: 4.0),
            Item(id: "regen_injector", weight: 1.0),
            Item(id: "splint", weight: 1.0),
