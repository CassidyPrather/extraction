// Loot tables. A map marker or a piece of furniture names a table; the
// table rolls `rolls` times over weighted entries. Item conditions are
// rolled in the given range (0 broken .. 1 pristine).
(
    tables: {
        "food_common": (rolls: (1, 2), entries: [
            Item(id: "canned_stew", weight: 3.0),
            Item(id: "canned_beans", weight: 3.0),
            Item(id: "canned_tomato", weight: 2.0),
            Item(id: "crackers", weight: 3.0),
            Item(id: "tea_tin", weight: 1.5),
            Item(id: "sugar_cubes", weight: 1.5),
            Item(id: "condensed_milk", weight: 1.0),
            Item(id: "water_bottle", weight: 2.5),
            Item(id: "rice_bag", weight: 1.0),
            Item(id: "salt_packet", weight: 1.0),
            Nothing(weight: 2.0),
        ]),
        "kitchen": (rolls: (1, 3), entries: [
            Table(name: "food_common", weight: 6.0),
            Item(id: "onion", weight: 1.0),
            Item(id: "carrot", weight: 1.0),
            Item(id: "flour_sack", weight: 0.6),
            Item(id: "egg_powder", weight: 0.6),
            Item(id: "spice_jar", weight: 0.8),
            Item(id: "matches", weight: 1.5),
            Table(name: "curio", weight: 0.5),
            Nothing(weight: 3.0),
        ]),
        "curio": (rolls: (1, 1), entries: [
            Item(id: "wristwatch", weight: 1.0),
            Item(id: "old_photo", weight: 2.0),
            Item(id: "chess_piece", weight: 1.0),
            Table(name: "tapes", weight: 1.5),
        ]),
        "tapes": (rolls: (1, 1), entries: [
            Item(id: "tape_practice", weight: 1.0),
            Item(id: "tape_hymns", weight: 1.0),
            Item(id: "tape_lodge", weight: 1.0),
            Item(id: "tape_duty", weight: 1.0),
            Item(id: "record_augustin", weight: 0.4),
            Item(id: "record_entertainer", weight: 0.4),
            Item(id: "record_susanna", weight: 0.4),
        ]),
        "ammo_common": (rolls: (1, 2), entries: [
            Item(id: "ammo_9x18", weight: 3.0),
            Item(id: "ammo_545", weight: 2.0),
            Item(id: "ammo_762r", weight: 1.2),
            Item(id: "ammo_12ga", weight: 2.0),
            Item(id: "pm_mag", weight: 1.0, condition: (0.4, 1.0)),
            Item(id: "ak_mag", weight: 0.6, condition: (0.4, 1.0)),
            Item(id: "mosin_clip", weight: 1.0),
            Item(id: "ammo_762x39", weight: 1.0),
            Item(id: "sks_clip", weight: 0.8),
            Item(id: "ammo_762x38r", weight: 1.5),
            Item(id: "ammo_762x25", weight: 0.8),
            Item(id: "ppsh_drum", weight: 0.25, condition: (0.4, 1.0)),
            Item(id: "rgd5", weight: 0.4),
            Item(id: "f1", weight: 0.2),
            Item(id: "helmet", weight: 0.6, condition: (0.4, 1.0)),
            Item(id: "ammo_545_tracer", weight: 0.4),
            Item(id: "ammo_545_t4", weight: 0.5),
            Item(id: "ammo_762x39_tracer", weight: 0.3),
            Item(id: "ammo_762r_tracer", weight: 0.2),
            Item(id: "ammo_12ga_slug", weight: 0.4),
            // Spent cases, kept for re-packing.
            Item(id: "brass", weight: 1.5),
            // The armoury's (docs/ARMOURY.md).
            Item(id: "ammo_22lr", weight: 1.0),
            Item(id: "svd_mag", weight: 0.12, condition: (0.4, 1.0)),
            Item(id: "rpk_mag", weight: 0.15, condition: (0.4, 1.0)),
            Item(id: "flare_white", weight: 0.4),
            Item(id: "flare_red", weight: 0.3),
            Item(id: "flare_green", weight: 0.2),
            Item(id: "bolt_bundle", weight: 0.3),
        ]),
        "weapons_rare": (rolls: (1, 1), entries: [
            Item(id: "pm_pistol", weight: 3.0, condition: (0.3, 0.9)),
            Item(id: "toz_double", weight: 2.0, condition: (0.3, 0.9)),
            Item(id: "mosin", weight: 1.2, condition: (0.3, 0.85)),
            Item(id: "ak74", weight: 0.6, condition: (0.25, 0.8)),
            Item(id: "sks", weight: 0.8, condition: (0.3, 0.85)),
            Item(id: "nagant", weight: 1.8, condition: (0.3, 0.9)),
            Item(id: "ppsh", weight: 0.24, condition: (0.25, 0.8)),
            Item(id: "steel_plate", weight: 0.35, condition: (0.4, 1.0)),
            Item(id: "vest", weight: 0.3, condition: (0.4, 1.0)),
            Item(id: "ammo_545_ap", weight: 0.25),
            Item(id: "ammo_762x39_ap", weight: 0.2),
            Item(id: "ammo_762r_ap", weight: 0.15),
            // The armoury's (docs/ARMOURY.md): the pump about as often as
            // the double, the .22 and the flare gun a little less, the
            // SVD and the RPK as rare as the PPSh.
            Item(id: "mp133", weight: 1.6, condition: (0.3, 0.9)),
            Item(id: "toz8", weight: 1.0, condition: (0.3, 0.9)),
            Item(id: "flare_pistol", weight: 0.6, condition: (0.4, 0.95)),
            Item(id: "svd", weight: 0.15, condition: (0.25, 0.8)),
            Item(id: "rpk74", weight: 0.18, condition: (0.25, 0.8)),
            Item(id: "crossbow", weight: 0.3, condition: (0.3, 0.85)),
        ]),
        // What each valley has more of (`LootTables::roll_in`: a table
        // `<name>@<valley>` stands in for `<name>` there).
        // Marrow Creek: hunting country, farms.
        "weapons_rare@marrow_creek": (rolls: (1, 1), entries: [
            Table(name: "weapons_rare", weight: 6.0),
            Item(id: "toz8", weight: 1.5, condition: (0.3, 0.9)),
            Item(id: "mp133", weight: 0.8, condition: (0.3, 0.9)),
            Item(id: "crossbow", weight: 0.4, condition: (0.3, 0.85)),
        ]),
        "ammo_common@marrow_creek": (rolls: (1, 1), entries: [
            Table(name: "ammo_common", weight: 8.0),
            Item(id: "ammo_22lr", weight: 1.5),
        ]),
        // Kettle Pass: long sightlines, a militia post on the pass.
        "weapons_rare@kettle_pass": (rolls: (1, 1), entries: [
            Table(name: "weapons_rare", weight: 6.0),
            Item(id: "svd", weight: 0.3, condition: (0.25, 0.8)),
            Item(id: "svd_mag", weight: 0.4, condition: (0.4, 1.0)),
        ]),
        // Cinder Works: guard posts, the rail yard's signal boxes.
        "weapons_rare@cinder_works": (rolls: (1, 1), entries: [
            Table(name: "weapons_rare", weight: 6.0),
            Item(id: "rpk74", weight: 0.35, condition: (0.25, 0.8)),
            Item(id: "rpk_mag", weight: 0.5, condition: (0.4, 1.0)),
            Item(id: "flare_pistol", weight: 0.6, condition: (0.4, 0.95)),
        ]),
        "ammo_common@cinder_works": (rolls: (1, 1), entries: [
            Table(name: "ammo_common", weight: 8.0),
            Item(id: "flare_white", weight: 0.6),
            Item(id: "flare_red", weight: 0.4),
        ]),
        // Sallow Reservoir: the dam's keepers signalled with flares.
        "weapons_rare@sallow_reservoir": (rolls: (1, 1), entries: [
            Table(name: "weapons_rare", weight: 6.0),
            Item(id: "flare_pistol", weight: 0.8, condition: (0.4, 0.95)),
            Item(id: "mp133", weight: 0.6, condition: (0.3, 0.9)),
        ]),
        "ammo_common@sallow_reservoir": (rolls: (1, 1), entries: [
            Table(name: "ammo_common", weight: 8.0),
            Item(id: "flare_white", weight: 0.6),
            Item(id: "flare_green", weight: 0.4),
        ]),
        "tools": (rolls: (1, 2), entries: [
            Item(id: "cleaning_rod", weight: 0.3),
            Item(id: "multitool", weight: 0.6),
            Item(id: "cleaning_kit", weight: 1.0),
