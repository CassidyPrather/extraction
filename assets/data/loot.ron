        "house": (rolls: (1, 3), entries: [
            Table(name: "kitchen", weight: 4.0),
            Table(name: "tools", weight: 2.0),
            Table(name: "medical", weight: 1.0),
            Table(name: "ammo_common", weight: 1.0),
            Table(name: "curio", weight: 1.5),
            Table(name: "gadgets", weight: 0.5),
            Table(name: "weapons_rare", weight: 0.2),
            Nothing(weight: 3.0),
        ]),
        "drone_wreck": (rolls: (1, 2), entries: [
            Item(id: "rotor_assembly", weight: 3.0, condition: (0.2, 0.9)),
