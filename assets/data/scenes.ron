// Staged scenes (src/world/scenes.rs, docs/LORE.md "Staged scenes").
// Each is a moment someone didn't come back from, at a point of interest,
// in its own frame: x right, -z ahead (where `rot` faces, as a marker's),
// y up from where it rests. Tables' tops are at 0.785; a crate's top is its
// size; a chair's seat is at 0.45. Things are laid out again each Surge
// cycle, with the loot.
[
    (
        map: "marrow_creek",
        name: "Farm barricade",
        // Behind crates in the farmyard, facing the Gate.
        at: (176.0, 153.0),
        rot: 315.0,
        pieces: [
            Crate(at: (-0.9, -1.0), size: 0.9),
            Barrel(at: (0.2, -1.15)),
            Crate(at: (1.1, -0.95), size: 0.7),
            Remains(at: (0.3, 0.7), rot: 30.0, seated: false),
        ],
        items: [
            (id: "brass", at: (-0.5, 0.0, -0.4)),
            (id: "brass", at: (0.6, 0.0, -0.3), rot: 70.0),
            (id: "ak_mag", at: (-0.2, 0.0, 0.25), rot: 20.0, condition: 0.6),
            (id: "field_dressing", at: (1.0, 0.0, 0.5)),
        ],
        note: Some((
            name: "Barricade note",
            text: "Called our driver at six. Nothing.\nHolding the farm till he comes. Three of us.\nTwo.",
            at: (-0.9, 0.9, -1.0),
            rot: 0.0,
        )),
    ),
    (
        map: "marrow_creek",
        name: "Path marker",
        // Where the ranger's path leaves the footbridge: the pump keeper's
        // word for the quiet way.
        at: (-175.0, -41.0),
        rot: 0.0,
        pieces: [
            Crate(at: (0.0, 0.0), size: 0.5),
        ],
        note: Some((
            name: "Path note",
            text: "The quiet way to the tower is up the ranger's path. The machines keep to the roads, and the pylons can't see under the spruce.\n- O.B.",
            at: (0.0, 0.5, 0.0),
            rot: 0.0,
        )),
    ),
    (
        map: "marrow_creek",
        name: "Survey table",
        // The survey team's table on the Hollow's edge, below the post.
        at: (114.0, -14.0),
        rot: 60.0,
        pieces: [
            Table(at: (0.0, 0.0), rot: 0.0),
            Chair(at: (0.15, 0.75), rot: 200.0),
            Crate(at: (1.35, -0.3), size: 0.7),
