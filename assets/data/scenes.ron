    // --- Hana's thread (world::story::BEATS, docs/LORE.md "The arc"):
    // each opens with a rank of the driver's job ladder, the last with the
    // recall.
    (
        map: "marrow_creek",
        name: "Rusty's corner",
        // Behind the house by the well: the dog's bed and his tin.
        at: (-25.5, 96.0),
        rot: 90.0,
        after: Some(Tier(1)),
        pieces: [
            Pallet(at: (0.0, 0.0), rot: 0.0),
            Chair(at: (1.1, 0.3), rot: 200.0),
        ],
        items: [
            (id: "canned_stew", at: (0.3, 0.144, 0.15), condition: 0.2),
        ],
        note: Some((
            name: "Rusty's note",
            text: "Rusty went today. Walked up to the white one by the bins and sat, good as gold, and it picked him up like a parcel and carried him to the Gate.\nKept, the inspector says. Everything is kept, for the review.\nHis lead's on the hook. - H.",
            at: (1.1, 0.45, 0.3),
            rot: 0.0,
        )),
    ),
    (
        map: "marrow_creek",
        name: "Hana's basket",
        // In the shelter's hall under the village (room "hall", site
