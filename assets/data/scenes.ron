        note: Some((
            name: "Letters note",
            text: "No post since October, so I carried the inspector's letters round the valleys for him that first winter.\nThe last went by hand to an old woman by a well in Marrow. She gave me bread for the road and asked after the buses.\n- T.R.",
            at: (0.0, 0.5, 0.0),
            rot: 0.0,
        )),
    ),
