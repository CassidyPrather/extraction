        ],
        items: [
            (id: "old_photo", at: (0.5, 0.5, -0.45), condition: 0.3),
        ],
        note: Some((
            name: "Shelter note",
            text: "Day 30 down here. They took Jan from the street on the 3rd. I came down with the lamp oil.\nThe filters still turn. The machines don't come down the stair. I think they can't count us if they can't see us.\n- E. Holm",
            at: (0.6, 0.5, -0.35),
            rot: 0.0,
        )),
    ),
