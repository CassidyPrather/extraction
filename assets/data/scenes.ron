        ],
        note: Some((
            name: "Quarry watch note",
            text: "Three evenings counting what the walkers carry up to the quarry. Pipe. A bath. A cot. A door. Cable. They come down empty.\nWhatever is in that shelter, they are building round it.\n- F.",
            at: (0.0, 0.45, 0.0),
            rot: 0.0,
        )),
    ),
    (
        map: "cinder_works",
        name: "The inspector",
        // In the works garage, by the office: he said he'd wait.
        at: (-25.5, -24.5),
        rot: 90.0,
        pieces: [
            Table(at: (0.0, 0.0), rot: 0.0),
            Chair(at: (0.0, 0.65), rot: 0.0),
            Remains(at: (0.0, 0.65), rot: 0.0, seated: true),
            Lantern(at: (0.45, 0.785, -0.2)),
        ],
        items: [
            (id: "radio", at: (0.22, 0.785, 0.05), condition: 0.15),
            (id: "wristwatch", at: (-0.38, 0.785, 0.12), condition: 0.3),
        ],
        note: Some((
            name: "Inspector's letter",
            text: "For whoever comes for the review.\nI have kept the three keys where the machines won't move them. M: with Vey, in the Hollow. K: in the quarry shelter. C: here, under the chimney.\nTogether, at any Gate's lock, they stop it all. I could not get them back alone, and nobody came.\nI am told to wait. I am waiting.\nP. Rus, Inspector",
            at: (-0.12, 0.785, -0.12),
            rot: 0.0,
        )),
    ),
    (
        map: "cinder_works",
        name: "Last fire in the dead wood",
