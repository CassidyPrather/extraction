        note: Some((
            name: "Hana's last page",
            text: "Feb. The cough again, and the machines are counting the houses.\nIf they come for me, they come. I've written to Lev and left it on the table where he'll look first.\nHe's not to come in after me. - H.",
            at: (0.0, 0.45, 0.0),
            rot: 0.0,
        )),
