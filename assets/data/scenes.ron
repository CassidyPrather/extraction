        note: Some((
            name: "Novakova's note",
            text: "We didn't go over the pass. Grandad wouldn't, and we wouldn't without him.\nThe bird went up first every morning, the way he said, and came back singing. So we stayed another day.\nGrandad died on the 9th. Petr counts the days on the post in chalk. I let him.\nWe're going up tonight, while there's no moon.\n- M. Novakova",
            at: (0.9, 0.0, 0.0),
            rot: 270.0,
        )),
