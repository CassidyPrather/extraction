        ],
        items: [
            (id: "compass", at: (0.25, 0.785, -0.12)),
            (id: "old_photo", at: (-0.05, 0.785, 0.18), rot: 15.0, condition: 0.3),
            (id: "flashlight", at: (1.35, 0.7, -0.3), rot: 90.0, condition: 0.2),
        ],
        note: Some((
            name: "Stake readings",
            text: "HOLLOW - CENTRE STAKES\nC1 +41 cm. C2 +44 cm. C3 +52 cm. C4 not found.\nO.V. gone down to C4 with the box, 0640.\nWaited till 1000. Going back up for the lamp. - T.",
            at: (0.2, 0.785, 0.1),
            rot: 0.0,
        )),
    ),
    (
        map: "kettle_pass",
        name: "Supper at the charcoal hut",
