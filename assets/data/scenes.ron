        note: Some((
            name: "Basket note",
            text: "E. - bread, and the paraffin. Leave the tin on the step when it's empty.\nThe machines don't look twice at an old woman with a basket. You'll see.\nIf Jan comes back I'll send him down. - H.",
            at: (0.06, 0.4, -0.02),
            rot: 0.0,
        )),
    ),
