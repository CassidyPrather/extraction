    (
        map: "kettle_pass",
        name: "Quarry watch",
        // A chair facing the quarry, binoculars beside it.
        at: (160.0, -80.0),
        rot: 135.0,
        pieces: [
            Chair(at: (0.0, 0.0), rot: 0.0),
