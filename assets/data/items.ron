        (
            id: "detector_sweep", dims: Some((0.07, 0.04, 0.2)), name: "Sweep detector",
            description: "A survey detector with a long whip antenna. Held, it hears only what it points at, and a second, higher voice sings out for a loose stone in its beam. Worn, it's a plain clicker.",
            category: Gadget, size: Small, mass: 0.45, bulk: 0.35,
            tags: ["metal", "electronics"],
        ),
        (
            id: "detector_bear", dims: Some((0.09, 0.05, 0.16)), name: "Bear detector",
            description: "The Authority's own field set, its round green screen scratched. Held up, it shows the stones near you as dots and the anomalies as rings, the way you face.",
            category: Gadget, size: Small, mass: 0.6, bulk: 0.4,
            tags: ["metal", "electronics"],
        ),
        (
            id: "lead_case", dims: Some((0.11, 0.07, 0.11)), name: "Lead-lined case",
            description: "A heavy little box with a lid that seals. Whatever sits inside it, the Zone can't feel — and it can't do anything for you either.",
            category: Gadget, size: Small, mass: 2.4, bulk: 0.7,
            tags: ["metal"],
        ),
        (
            id: "emp_grenade", dims: Some((0.065, 0.11, 0.065)), name: "EMP grenade",
            description: "Pull, throw, count. Robots nearby forget how to stand for a while.",
            category: Gadget, size: Small, mass: 0.4, bulk: 0.3,
            tags: ["electronics"],
        ),
        (
            id: "emp_trap", name: "EMP trap",
            description: "A puck you leave on the ground. The first robot to step near it regrets it.",
            category: Gadget, size: Small, mass: 0.7, bulk: 0.5,
            tags: ["electronics"],
        ),
        (
            id: "camera_drone", dims: Some((0.2, 0.06, 0.2)), name: "Camera drone",
            description: "A palm-sized quadcopter. Spin it up and let go: it circles where you released it and marks the robots it sees. Its feed shows on your wrist.",
            category: Gadget, size: Medium, mass: 0.5, bulk: 1.2,
            tags: ["electronics", "polymer"],
        ),
        (
            id: "cloak_generator", dims: Some((0.25, 0.3, 0.25)), name: "Cloak generator",
            description: "Deploy it and robots stop seeing what's inside the bubble. Drinks power.",
            category: Gadget, size: Large, mass: 3.5, bulk: 6.0,
            tags: ["electronics", "metal"],
        ),
        (
            id: "deployable_cover", dims: Some((0.6, 0.12, 0.5)), name: "Deployable cover",
            description: "A folding ballistic panel on legs.",
            category: Gadget, size: Large, mass: 6.0, bulk: 8.0,
            tags: ["metal"],
        ),
        (
            id: "climbing_kit", name: "Climbing kit",
            description: "Rope, a grapnel and a harness.",
            category: Gadget, size: Large, mass: 2.4, bulk: 4.0,
            tags: ["metal"],
        ),
        (
            id: "zipline_kit", name: "Zipline kit",
            description: "Two anchors, a trolley, sixty metres of cable.",
            category: Gadget, size: Large, mass: 3.0, bulk: 4.5,
            tags: ["metal"],
        ),
        (
            id: "matches", dims: Some((0.036, 0.019, 0.055)), name: "Matches",
            category: Gadget, size: Tiny, mass: 0.02, bulk: 0.02,
        ),
        (
            id: "door_wedge", dims: Some((0.048, 0.031, 0.052)), name: "Door wedge",
            description: "Jams a door shut. Robots have to go around, or through.",
            category: Gadget, size: Small, mass: 0.25, bulk: 0.15,
            tags: ["polymer"],
        ),

