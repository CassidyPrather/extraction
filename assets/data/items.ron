// The item catalog. Every physical thing in the game is one of these.
//
// mass: kilograms. bulk: litres of backpack. size: which body slots take it
// (Tiny: pockets; Small: pouches; Medium: holster; Large: backpack only;
// Bulky: slings only). attention: per second while carried.
//
// Ids are stable: saves and map files refer to them. Rename the `name`, not
// the `id`.
(
    items: [
        // ---------------------------------------------------------------
        // Firearms
        // ---------------------------------------------------------------
        (
            id: "pm_pistol", dims: Some((0.032, 0.127, 0.161)),
            name: "PM pistol",
            description: "A compact Soviet service pistol. Double-action first shot, slide locks on empty. Heavy trigger, honest gun.",
            category: Firearm, size: Medium, mass: 0.73, bulk: 0.6,
            firearm: Some((
                action: SemiAuto, cartridge: "9x18", magazine_family: Some("pm"),
                modes: [Safe, Semi], last_round_hold_open: true, double_action: true,
                muzzle_velocity: 315.0, damage: 34.0, spread_moa: 10.0, recoil: 1.0,
                wear_per_shot: 0.0006,
            )),
            tags: ["metal"],
        ),
        (
            id: "ak74", dims: Some((0.07, 0.24, 0.943)),
            name: "AK-74 rifle",
            description: "Stamped receiver, side-folding charging handle, the selector you push with your trigger finger. Safe, auto, semi — in that order.",
            category: Firearm, size: Bulky, mass: 3.3, bulk: 6.0,
            firearm: Some((
                action: SemiAuto, cartridge: "5.45x39", magazine_family: Some("ak545"),
                modes: [Safe, Auto, Semi], rpm: 650.0,
                muzzle_velocity: 900.0, damage: 48.0, spread_moa: 4.0, recoil: 2.2,
                wear_per_shot: 0.0004,
            )),
            tags: ["metal", "wood"],
        ),
        (
            id: "mosin", dims: Some((0.07, 0.17, 1.23)),
            name: "Mosin bolt rifle",
            description: "A five-shot turn-bolt older than anyone who has carried it. Lift, pull, push, drop. Hits like a door.",
            category: Firearm, size: Bulky, mass: 4.0, bulk: 7.5,
            firearm: Some((
                action: BoltAction, cartridge: "7.62x54R", internal_capacity: 5,
                modes: [Semi],
                muzzle_velocity: 865.0, damage: 110.0, spread_moa: 1.5, recoil: 4.5,
                wear_per_shot: 0.0003,
            )),
            tags: ["metal", "wood"],
        ),
        (
            id: "sks", dims: Some((0.07, 0.2, 1.05)),
            name: "SKS carbine",
            description: "A ten-shot self-loader with a fixed magazine and a folding bayonet. Lock the bolt back, push a clip down through the top, let it go.",
            category: Firearm, size: Bulky, mass: 3.85, bulk: 6.5,
            firearm: Some((
                action: SemiAuto, cartridge: "7.62x39", internal_capacity: 10,
                modes: [Safe, Semi], last_round_hold_open: true,
                muzzle_velocity: 735.0, damage: 70.0, spread_moa: 3.0, recoil: 2.8,
                wear_per_shot: 0.00035,
            )),
            tags: ["metal", "wood"],
        ),
        (
            id: "toz_double", dims: Some((0.075, 0.16, 1.12)),
            name: "Double-barrel shotgun",
            description: "Side-by-side twelve gauge. Break it, drop two in, snap it shut. Ejectors throw the empties over your shoulder.",
            category: Firearm, size: Bulky, mass: 3.2, bulk: 6.5,
            firearm: Some((
                action: BreakAction, cartridge: "12ga", barrels: 2,
                modes: [Semi],
