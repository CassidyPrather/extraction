        // ---------------------------------------------------------------
        (
            id: "cleaning_kit", dims: Some((0.08, 0.05, 0.25)), name: "Cleaning kit",
            description: "Rod, brushes, patches. Takes the fouling out of a gun.",
            category: Tool, size: Medium, mass: 0.35, bulk: 0.4,
            tags: ["metal"],
        ),
        (
            id: "gun_oil", name: "Gun oil",
            category: Tool, size: Small, mass: 0.15, bulk: 0.12,
        ),
        (
            id: "spare_parts", dims: Some((0.053, 0.03, 0.042)), name: "Firearm spare parts",
            description: "Springs, pins, an extractor. Brings a worn gun back toward its best.",
            category: Tool, size: Small, mass: 0.3, bulk: 0.2,
            tags: ["metal"],
        ),
        (
            id: "multitool", dims: Some((0.068, 0.016, 0.1)), name: "Multitool",
            category: Tool, size: Small, mass: 0.25, bulk: 0.1,
            tags: ["metal"],
        ),
        (
            id: "crowbar", dims: Some((0.03, 0.05, 0.76)), name: "Crowbar",
            description: "Put the claw to a seam and lean on the end with both hands. Plates, jammed doors.",
            category: Tool, size: Medium, mass: 1.6, bulk: 1.2,
            tags: ["steel"],
        ),
        (
            id: "bolt_cutters", dims: Some((0.16, 0.04, 0.62)), name: "Bolt cutters",
            description: "A handle in each hand, jaws on the shackle or the wire, squeeze. Padlocks, chain-link.",
            category: Tool, size: Medium, mass: 2.1, bulk: 1.4,
            tags: ["steel"],
        ),
        (
            id: "fuel_can", dims: Some((0.17, 0.35, 0.3)), name: "Fuel can",
            description: "Ten litres of diesel. The truck will take you places for this.",
            category: Tool, size: Large, mass: 9.5, bulk: 12.0,
            tags: ["fuel"],
        ),

        // ---------------------------------------------------------------
        // Materials (bench inputs)
        // ---------------------------------------------------------------
        (id: "scrap_metal", dims: Some((0.072, 0.038, 0.057)), name: "Scrap metal", category: Material, size: Small, mass: 0.4, bulk: 0.4, tags: ["metal"]),
        (id: "electronics", name: "Salvaged electronics", category: Material, size: Small, mass: 0.2, bulk: 0.3, tags: ["electronics"]),
        (id: "polymer", dims: Some((0.068, 0.029, 0.052)), name: "Polymer stock", category: Material, size: Small, mass: 0.3, bulk: 0.4, tags: ["polymer"]),
        (id: "powder", dims: Some((0.045, 0.058, 0.026)), name: "Powder tin", category: Material, size: Small, mass: 0.3, bulk: 0.2, tags: ["powder"]),
        (id: "brass", name: "Brass cases", category: Material, size: Small, mass: 0.25, bulk: 0.15, tags: ["brass"]),
        (id: "bolt", dims: Some((0.016, 0.016, 0.07)), name: "Bolt", description: "A rusty M10 bolt with its nut run on. Worth nothing; throw it ahead of you where the air looks wrong.", category: Material, size: Tiny, mass: 0.06, bulk: 0.02, tags: ["metal"]),

        // ---------------------------------------------------------------
        // Robot parts
        // ---------------------------------------------------------------
        (
            id: "rotor_assembly", name: "Rotor assembly",
            description: "A drone's motor, still spinning down.",
            category: RobotPart, size: Small, mass: 0.4, bulk: 0.6,
            tags: ["electronics", "metal"],
        ),
        (
            id: "servo", name: "Servo actuator",
            category: RobotPart, size: Small, mass: 0.6, bulk: 0.4,
            tags: ["electronics", "metal"],
        ),
        (
            id: "sensor_eye", name: "Sensor eye",
            description: "The lens still tracks movement for a few seconds after you pull it.",
            category: RobotPart, size: Small, mass: 0.3, bulk: 0.25,
            tags: ["electronics", "glass"],
        ),
        (
            id: "robot_cell", dims: Some((0.067, 0.049, 0.085)), name: "Robot power cell",
            category: RobotPart, size: Small, mass: 0.9, bulk: 0.5, battery_wh: 120.0,
            tags: ["electronics"],
        ),
        (
            id: "robot_gunpod", dims: Some((0.22, 0.25, 1.1)), name: "Robot gun pod",
            description: "You can carry it. You can even pull the trigger, with both hands and a prayer.",
            category: RobotPart, size: Bulky, mass: 7.5, bulk: 10.0,
            tags: ["metal", "electronics"],
        ),
        // One part per class, dropped by a robot's part still alive when it
        // dies (robots/wreck.rs).
        (
            id: "drone_rotor_motor", dims: Some((0.253, 0.084, 0.251)), name: "Drone rotor motor",
            description: "A drone's motor on its snapped struts, a curl of the duct still on it. The windings are good.",
            category: RobotPart, size: Small, mass: 0.5, bulk: 0.8,
            tags: ["electronics", "metal"],
        ),
        (
            id: "walker_leg_actuator", dims: Some((0.143, 0.388, 0.165)), name: "Walker knee actuator",
            description: "A walker's knee, torn off between thigh and shin. The screw jack behind it could lift a truck.",
            category: RobotPart, size: Medium, mass: 3.5, bulk: 2.5,
            tags: ["electronics", "metal"],
        ),
        (
            id: "crawler_capacitor", dims: Some((0.126, 0.126, 0.284)), name: "Crawler capacitor bank",
            description: "The spark gun off a crawler, still on the cans that fed it. Don't touch the prongs.",
            category: RobotPart, size: Small, mass: 1.2, bulk: 1.0,
            tags: ["electronics"],
        ),
        (
            id: "dirigible_gas_valve", dims: Some((0.37, 0.198, 0.332)), name: "Airship gas valve",
            description: "A lift-gas valve with a scrap of the envelope still clamped under its ring.",
            category: RobotPart, size: Medium, mass: 2.0, bulk: 3.0,
            tags: ["electronics", "metal"],
        ),
        (
            id: "pylon_relay_coil", dims: Some((0.132, 0.266, 0.118)), name: "Pylon relay coil",
            description: "Copper wound on a dark core, warm to the touch long after the pylon went quiet.",
            category: RobotPart, size: Small, mass: 1.8, bulk: 1.0,
            tags: ["electronics", "metal"],
        ),
        (
            id: "sorter_servo_pack", dims: Some((0.352, 0.86, 0.557)), name: "Sorter servo pack",
            description: "The Sorter's elbow, hinge and ram and all. It sorted cars by the ton; it's heavy to carry.",
            category: RobotPart, size: Bulky, mass: 9.0, bulk: 8.0,
            tags: ["electronics", "metal"],
        ),

        // ---------------------------------------------------------------
        // Artifacts. Every one draws attention while carried.
        // ---------------------------------------------------------------
        (
            id: "art_featherstone", dims: Some((0.036, 0.031, 0.03)), name: "Featherstone",
            description: "A grey pebble that would rather be on the ceiling. Negative mass; let go of it and it falls up. It wants to go home: lifts you pass wind up and pop.",
            category: Artifact, size: Tiny, mass: 0.2, bulk: 0.05, attention: 0.6, lift_kg: 6.0,
        ),
        (
            id: "art_hearth", dims: Some((0.053, 0.054, 0.054)), name: "Hearth",
            description: "A warm, faintly humming lump. Power gadgets plugged into it never run down. Carried, it runs you hot; your wind comes back slowly.",
            category: Artifact, size: Small, mass: 0.8, bulk: 0.3, attention: 1.2,
        ),
        (
            id: "art_glasseye", name: "Glass eye",
            description: "Hold it to your eye and the walls go thin.",
            category: Artifact, size: Tiny, mass: 0.1, bulk: 0.04, attention: 0.9,
        ),
        (
            id: "art_aegis", dims: Some((0.047, 0.028, 0.044)), name: "Aegis knot",
            description: "A tangle of something like copper. While you carry it, the first hit always glances. It holds a charge, and wet it bites.",
            category: Artifact, size: Small, mass: 0.6, bulk: 0.2, attention: 1.0,
        ),
        (
            id: "art_lodestone", dims: Some((0.06, 0.05, 0.055)), name: "Lodestone",
            description: "A fist of dark iron, far heavier than it looks once it's on you. Rounds fired at whoever carries it curve aside.",
            category: Artifact, size: Small, mass: 1.6, bulk: 0.25, attention: 1.1, lift_kg: -5.0,
        ),
        (
            id: "art_stormglass", dims: Some((0.04, 0.04, 0.04)), name: "Stormglass",
            description: "A clouded bead, cold as hail and never melting, grown only where the Surge itself broke the ground. Carry it and the Surge passes over you as if you were under a roof. The whole Zone knows where it is.",
            category: Artifact, size: Tiny, mass: 0.1, bulk: 0.03, attention: 3.0,
        ),
        (
            id: "art_shard", dims: Some((0.02, 0.11, 0.05)), name: "Mirror shard",
            description: "A sliver of something not quite glass. Your reflection in it moves a moment late, and now and then it glints where anything can see. Hold it and use it to step through, a few metres ahead; it needs a minute to brighten again.",
            category: Artifact, size: Tiny, mass: 0.05, bulk: 0.03, attention: 0.8,
        ),

        // ---------------------------------------------------------------
        // The valley keys: the Quarantine Authority's depot keys, one per
        // valley. Bring all three to a robot Gate's lock (see `capstone`).
        (
            id: "key_marrow", dims: Some((0.09, 0.03, 0.14)), name: "Depot key M",
            description: "A heavy grey cartridge stencilled KEY-M MARROW. The Hollow survey post's, by the tag on it.",
            category: Curio, size: Small, mass: 0.5, bulk: 0.15, tags: ["metal", "electronics"],
        ),
        (
            id: "key_kettle", dims: Some((0.09, 0.03, 0.14)), name: "Depot key K",
            description: "A heavy grey cartridge stencilled KEY-K KETTLE, scorched along one edge.",
            category: Curio, size: Small, mass: 0.5, bulk: 0.15, tags: ["metal", "electronics"],
        ),
        (
            id: "key_cinder", dims: Some((0.09, 0.03, 0.14)), name: "Depot key C",
            description: "A heavy grey cartridge stencilled KEY-C CINDER, gritty with ash.",
            category: Curio, size: Small, mass: 0.5, bulk: 0.15, tags: ["metal", "electronics"],
        ),

        // Curios: no use but to keep, or to offer.
        // ---------------------------------------------------------------
        (id: "wristwatch", name: "Stopped wristwatch", description: "Stopped at twenty to seven. A lot of watches in the valleys did, one October evening.", category: Curio, size: Tiny, mass: 0.05, bulk: 0.02, tags: ["metal"]),
        (id: "old_photo", dims: Some((0.088, 0.01, 0.123)), name: "Faded photograph", description: "A family on a bench by a well, squinting into the sun. Names on the back, too faded to read.", category: Curio, size: Tiny, mass: 0.01, bulk: 0.01),
        (id: "chess_piece", name: "Wooden chess knight", description: "Carved by hand, the paint worn off its ears. The rest of the set is somewhere in the Zone.", category: Curio, size: Tiny, mass: 0.03, bulk: 0.02, tags: ["wood"]),
        // The first deep job after the ladder: the depot's ledger (`progression`).
        (
            id: "intake_ledger", dims: Some((0.24, 0.05, 0.32)), name: "Intake ledger",
            description: "A canvas-bound ledger stencilled GATE-M INTAKE. Every line in the same machine hand: what, where from, when, which bay.",
            category: Curio, size: Small, mass: 1.0, bulk: 0.5, tags: ["paper"],
        ),
        // The last of the driver's jobs (`progression`, `docs/LORE.md`).
        (
            id: "hana_letter", dims: Some((0.11, 0.004, 0.16)), name: "Letter from the village",
            description: "An envelope, sealed, in a careful hand: For Lev, when he comes back for me.",
            category: Curio, size: Tiny, mass: 0.01, bulk: 0.01, tags: ["paper"],
        ),
        // What the driver's Recover jobs send you for (`progression`).
        (
            id: "field_recorder", dims: Some((0.16, 0.06, 0.11)), name: "Field recorder",
            description: "A survey recorder in a grey-green case, stencilled QA-SURVEY 07. Its counter stopped on a Surge night. The driver wants what's on it.",
            category: Curio, size: Small, mass: 1.1, bulk: 0.6, tags: ["metal", "electronics"],
        ),
    ],
)
