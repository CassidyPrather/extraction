// Marrow Creek: the village pumping station, drowned since the pumps
// stopped (format: crates/extraction_core/src/underground.rs; design:
// docs/UNDERGROUND.md, "Signature sites"). The water's the puzzle: three
// basins, one under the next, each lowered by what the one above hides.
(
    // Not the region over it ("Pumping station"): a Recover job by that
    // name is the surface's.
    name: "The pump wells",
    style: Service,
    floor: -6.0,
    // Tall corridors: the flooded ones keep air over the water.
    corridor_height: 3.4,
    // Cold, green-white lamps over the water.
    lamp_colour: Some((0.62, 0.95, 0.88)),
    rooms: [
        // The dry top: the stair's foot, the control room, the valve gallery.
        (id: "upper_gallery", at: (0.0, 12.0), size: (10.0, 4.0), height: 3.0, lamp: Flicker, props: [
            (kind: Rubble, at: (3.2, 1.0)),
        ]),
        (id: "control", at: (10.0, 12.0), size: (4.0, 4.0), height: 2.6, lamp: Dead, props: [
            (kind: Table, at: (0.4, -1.2)),
            (kind: Chair, at: (0.4, -0.45), rot: 180.0),
            (kind: Shelf, at: (1.6, 1.0), rot: 270.0, loot: Some("gadgets")),
        ]),
        (id: "valve_gallery", at: (-10.0, 12.0), size: (4.0, 4.0), height: 2.6, lamp: Steady, props: [
            (kind: Machine, at: (0.4, 1.2)),
        ]),
        // The inlet chamber: chest deep at the start.
        (id: "inlet_chamber", at: (0.0, 24.0), size: (10.0, 8.0), floor: Some(-8.0), height: 5.0, lamp: Flicker, props: [
            (kind: Machine, at: (-3.0, -2.0)),
            (kind: Machine, at: (0.0, -2.0)),
            (kind: Crate, at: (3.6, -2.6), loot: Some("tools")),
        ]),
        // The screen room: over your head till the inlet's valve is turned.
        (id: "screen_room", at: (-14.0, 24.0), size: (6.0, 6.0), floor: Some(-9.0), height: 4.0, lamp: Dead, props: [
            (kind: Shelf, at: (-2.6, 1.0), rot: 90.0, loot: Some("medical")),
            (kind: Machine, at: (1.0, 1.6)),
        ]),
        // The pump hall: the big dead pumps, ankle deep.
        (id: "pump_hall", at: (0.0, 38.0), size: (10.0, 6.0), floor: Some(-9.0), height: 5.0, lamp: Steady, props: [
            (kind: Machine, at: (-3.0, 0.8)),
            (kind: Machine, at: (0.0, 0.8)),
            (kind: Barrel, at: (3.8, -2.0)),
        ]),
        (id: "store", at: (10.0, 38.0), size: (4.0, 4.0), floor: Some(-9.0), height: 2.6, lamp: Dead, props: [
            (kind: Shelf, at: (1.6, -0.8), rot: 270.0, loot: Some("food_common")),
            (kind: SmallCrate, at: (1.4, 1.4), loot: Some("tools")),
        ]),
        // The sump: the wet well, the operator's locker at the bottom.
        (id: "sump", at: (-14.0, 38.0), size: (6.0, 6.0), floor: Some(-11.0), height: 4.0, lamp: Dead, props: [
            (kind: Locker, at: (-2.65, 1.6), rot: 90.0),
            (kind: Crate, at: (-1.6, -1.6), loot: Some("shelter_armoury")),
            (kind: SmallCrate, at: (1.6, 1.8), loot: Some("ammo_common")),
        ]),
    ],
    links: [
        (from: "upper_gallery", to: "control", doors: To),
        (from: "upper_gallery", to: "valve_gallery", doors: To),
        (from: "upper_gallery", to: "inlet_chamber", width: 2.0),
        (from: "inlet_chamber", to: "screen_room", doors: To),
        (from: "inlet_chamber", to: "pump_hall", doors: Both),
        (from: "pump_hall", to: "sump"),
        (from: "screen_room", to: "sump"),
        (from: "pump_hall", to: "store", doors: To),
    ],
    basins: [
        (id: "inlet", rooms: ["inlet_chamber"], links: [("upper_gallery", "inlet_chamber")], level: -6.6),
        (id: "screens", rooms: ["screen_room"], links: [("inlet_chamber", "screen_room")], level: -6.9),
        (id: "sump", rooms: ["pump_hall", "sump", "store"], links: [("inlet_chamber", "pump_hall"), ("pump_hall", "sump"), ("screen_room", "sump"), ("pump_hall", "store")], level: -8.6),
    ],
    drains: [
        // The inlet's valve, dry in its gallery.
        (kind: Valve, room: "valve_gallery", at: (-1.75, 0.0), rot: 90.0, basin: "inlet", to: -8.0, rate: 0.05),
        // The screens' valve: at the inlet's far wall, under its water.
        (kind: Valve, room: "inlet_chamber", at: (3.0, 3.75), basin: "screens", to: -9.0, rate: 0.05),
        // The sump has nowhere to drain: the hand pump, in the screen room.
        (kind: Pump, room: "screen_room", at: (0.0, -2.75), rot: 180.0, basin: "sump", to: -11.0, rate: 0.1),
    ],
    // Brabec's good shoes, by his locker in the sump.
    items: [(id: "work_boots", room: "sump", at: (-1.4, 2.4), y: 0.0)],
    patrol: ["upper_gallery", "control", "upper_gallery", "valve_gallery"],
    crawlers: 1,
    // Over every kiosk's door: what's down there.
    sign: Some("MARROW WATER BOARD\nPUMP STATION - KEEP CLEAR"),
    portals: [
        (),
        // The outfall stair, from the pump hall up to the river bank.
        (at: (0.0, 55.0), rot: 180.0, y: -1.1, floor: Some(-9.0)),
    ],
)
