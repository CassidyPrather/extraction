            (kind: Rubble, at: (1.0, -1.8)),
        ]),
        (id: "mess", at: (5.0, 31.0), size: (6.0, 6.0), props: [
            (kind: Table, at: (0.3, 0.0), loot: Some("kitchen")),
            (kind: Chair, at: (0.3, -0.75)),
            (kind: Chair, at: (0.3, 0.75), rot: 180.0),
            (kind: Counter, at: (2.6, 0.0), rot: 90.0, loot: Some("food_common")),
        ]),
        // Filters and the generator: the plant keeps one lamp alight.
        (id: "plant", at: (-12.0, 24.0), size: (6.0, 7.0), height: 3.0, lamp: Steady, props: [
