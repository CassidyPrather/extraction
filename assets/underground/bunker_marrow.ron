            (kind: Locker, at: (-1.65, -0.4), rot: 270.0),
            (kind: Barrel, at: (1.5, 1.4)),
        ]),
        // The spine: everything opens off it.
        (id: "hall", at: (0.0, 24.0), size: (16.0, 3.0), lamp: Flicker, props: [
            (kind: Rubble, at: (-3.2, 0.9)),
            (kind: Crate, at: (6.6, -1.0), loot: Some("food_common")),
        ]),
        (id: "dorm", at: (-5.0, 31.0), size: (8.0, 6.0), lamp: Dead, props: [
