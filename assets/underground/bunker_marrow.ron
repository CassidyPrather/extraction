// Marrow Creek: the village's civil-defence shelter (see
// crates/extraction_core/src/underground.rs for the format, and
// docs/UNDERGROUND.md). Site space: the entrance kiosk's centre on the
// ground, +Z the way its stair goes down. Props are relative to their
// room's centre; rot as placements turn.
(
    name: "Civil-defence shelter",
    style: Bunker,
    floor: -7.0,
    rooms: [
        // The blast door at the stair's foot, a gas lock, decontamination.
        (id: "lock", at: (0.0, 11.0), size: (3.0, 3.0), height: 2.4, lamp: Dead, props: [
            (kind: Cabinet, at: (1.2, 0.0), rot: 90.0),
        ]),
        (id: "decon", at: (0.0, 16.5), size: (4.0, 4.0), height: 2.4, props: [
