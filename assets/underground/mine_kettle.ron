// Kettle Pass: the old mine's gallery, an incline down from an adit by
// the headframe (format: crates/extraction_core/src/underground.rs).
(
    name: "Mine gallery",
    style: Mine,
    floor: -6.0,
    corridor_height: 2.3,
    rooms: [
        (id: "station", at: (0.0, 10.0), size: (5.0, 4.0), height: 2.8, lamp: Flicker, props: [
            (kind: Cart, at: (1.6, 1.0)),
            (kind: Barrel, at: (2.1, -1.4)),
        ]),
        (id: "lamp_room", at: (-7.0, 10.0), size: (5.0, 4.0), height: 2.5, lamp: Steady, props: [
            (kind: Shelf, at: (-2.1, 0.0), rot: 270.0, loot: Some("tools")),
            (kind: Workbench, at: (0.0, 1.5), rot: 180.0, loot: Some("gadgets")),
            (kind: Locker, at: (1.0, -1.65)),
        ]),
        (id: "main_drive", at: (0.0, 22.0), size: (3.0, 16.0), height: 2.6, props: [
            (kind: Cart, at: (0.0, 5.0)),
            (kind: Rubble, at: (0.9, -2.5)),
        ]),
        (id: "west_crosscut", at: (-9.0, 24.0), size: (9.0, 2.5), height: 2.5),
        (id: "stope", at: (-12.0, 33.0), size: (8.0, 10.0), height: 4.0, lamp: Powered, props: [
            (kind: Rubble, at: (-2.4, -2.6)),
            (kind: Rubble, at: (2.5, 3.0)),
            (kind: Rubble, at: (-2.8, 3.4)),
            (kind: Cart, at: (1.6, -2.2), rot: 90.0),
            (kind: Crate, at: (-1.5, 0.6), loot: Some("curio")),
        ]),
        (id: "east_crosscut", at: (8.0, 28.0), size: (10.0, 2.5), height: 2.5),
        // Explosives store, behind its steel door: the best of it.
        (id: "magazine", at: (8.0, 34.0), size: (4.0, 4.0), height: 2.4, lamp: Powered, props: [
            (kind: Crate, at: (-1.2, 1.2), loot: Some("weapons_rare")),
            (kind: Crate, at: (1.2, 1.2), loot: Some("ammo_common")),
            (kind: Shelf, at: (1.65, -0.8), rot: 90.0, loot: Some("gadgets")),
        ]),
        (id: "sump", at: (8.0, 18.0), size: (6.0, 5.0), height: 3.0, lamp: Flicker, props: [
            (kind: Machine, at: (-1.5, 1.0)),
            // Past the bench's end (the first stood 5 cm into it).
            (kind: Barrel, at: (2.45, -1.8)),
            (kind: Barrel, at: (2.45, -1.15)),
            (kind: Workbench, at: (1.1, -2.05), rot: 180.0, loot: Some("workshop")),
        ]),
        (id: "refuge", at: (-6.0, 40.0), size: (5.0, 4.0), height: 2.4, lamp: Steady, props: [
            (kind: Bunk, at: (-1.0, -1.45), rot: 90.0),
            (kind: Cabinet, at: (1.4, -1.75)),
            (kind: Shelf, at: (-1.6, 1.75), rot: 180.0, loot: Some("medical")),
            (kind: SmallCrate, at: (1.6, 1.4), loot: Some("food_common")),
        ]),
        (id: "raise_foot", at: (0.0, 48.0), size: (3.0, 3.0), height: 2.4),
    ],
    links: [
        (from: "station", to: "main_drive"),
        (from: "station", to: "lamp_room", doors: To),
        (from: "main_drive", to: "west_crosscut", via: [(0.0, 24.0)]),
        (from: "west_crosscut", to: "stope", via: [(-12.0, 24.0)]),
        (from: "main_drive", to: "east_crosscut", via: [(0.0, 28.0)]),
        (from: "east_crosscut", to: "magazine", doors: To),
        (from: "main_drive", to: "sump", via: [(0.0, 18.0)], doors: To),
        (from: "sump", to: "east_crosscut"),
        (from: "stope", to: "refuge", via: [(-12.0, 40.0)], doors: To),
        (from: "main_drive", to: "refuge", via: [(0.0, 40.0)], doors: To),
        (from: "refuge", to: "raise_foot", via: [(-6.0, 48.0)], doors: To),
        // The old drive, drowned: from the lamp room straight to the west
        // crosscut, too deep to stand in.
        (from: "lamp_room", to: "west_crosscut", via: [(-9.0, 10.0)]),
    ],
    anomalies: [
        (kind: "Lift", room: "stope", at: (0.0, 0.0), radius: 2.6),
    ],
    // Resident maintenance crawlers walk this round (robots::indoor).
    patrol: ["station", "main_drive", "east_crosscut", "sump", "main_drive", "west_crosscut", "stope", "refuge"],
    crawlers: 1,
    // The breaker board in the wet sump, by the pump: throw it and the
    // stope and the magazine light, and the magazine's door opens.
    power: [(kind: Breaker, room: "sump", at: (2.75, 0.6), rot: 270.0, doors: ["magazine"])],
    floods: [
        (link: Some(("lamp_room", "west_crosscut")), depth: 1.35),
        (room: Some("sump"), depth: 0.4),
    ],
    // Over every kiosk's door: what's down there.
    sign: Some("KETTLE PASS COLLIERY\nNo. 1 DRIFT"),
    // What's down there, for a raider weighing the walk (its tables).
    rich: Some(1.2),
    portals: [
        (),
        (at: (0.0, 58.0), rot: 180.0, y: 0.4),
    ],
)
