        // notes:begin (generated by scripts/place_notes.py)
        (kind: Note(text: "SOUTH GATE, KETTLE - DUTY LOG\n3 Jan. Snow. Nothing in, nothing out.\nThe machines walked the fence again at 0200. Counting posts, Novak says. He's been up here too long.\n12 Feb. Smoke over the hill from Cinder. Orders: none.\n1 Apr. Review postponed. Post to stand down. Leave the stove."), at: (127.50, 284.40), rot: 153.4, name: "Gate log"),
        (kind: Note(text: "MINE OFFICE\nInspector Rus took Karel's key to the quarry blast shelter and locked the Kettle depot key inside \"for safe keeping\". He signed for it in our book, as if that made it ours.\nA week later the shelter started to burn without fire. Nobody goes up to the quarry now.\n- Irena, clerk"), at: (-54.20, 58.30), rot: 205.2, name: "Mine office note"),
        (kind: Note(text: "K. Dusek, shot-firer.\nShelter: poured concrete, 30 cm. Steel door, one lock. My key, until the inspector took it.\nSince November the air in the pit shimmers like over a stove, and nothing is burning. Bright stones on the benches, warm. My meter clicks at them.\nI have fired four hundred shots up there. I know what a shelter is for. That one is keeping something in.\nVey came up from Marrow to look. He went white."), at: (-29.30, 70.70), rot: 208.3, name: "Shot-firer's note"),
        (kind: Note(text: "Last train out, 15 Oct, 1140. Eleven wagons, people on the roofs.\nI closed the crossing gates behind it like always. Nobody told me to stop.\nEvery morning since, I close them at 1140.\nThe machines wait for the gates now. They stand at the barrier, very patient, till I lift it."), at: (76.70, 220.70), rot: 208.3, name: "Crossing keeper's note"),
        (kind: Note(text: "Sunday. Nobody came to the chapel but the machines. One of them stood at the back the whole service, very still, and then cleaned the windows.\nThe pass road is the only way the trucks still come in."), at: (-7.70, 155.40), rot: 356.8, name: "Chapel note"),
        (kind: Terminal(pages: ["CUSTODIAN NETWORK - KETTLE\n\nDepot GATE-K: ACTIVE\nMode: SWEEP\n\nRecovered personnel are kept\nat the depot pending review.", "KEY-K custody: quarry blast\nshelter, Kettle.\nSigned: P.RUS\n\nNote: field activity near the\nquarry. Unshielded personnel\nshould not approach."]), at: (-197.00, -94.20), rot: 152.7, name: "Pump station terminal"),
        (kind: Terminal(pages: ["RELAY LOG - MAST K2\n\nGrapplers carry stock to the\nwork sites. Dirigibles drop\npods where walkers are short.\n\nA recovered body goes to the\ndepot. Everything is kept.", "LINK STATUS\n\nM1  MARROW          OK\nC3  CINDER          DEGRADED\nAUTHORITY UPLINK    NO CARRIER\n  since 1 APR (3851 days)\n\nHolding reports for uplink."]), at: (76.23, -208.96), rot: 130.3, name: "Mast terminal"),
        (kind: Note(text: "KETTLE TOWER\nMarta's lamp from Marrow, 2100, three long: all well. Answered.\nThe quarry glows now too, like her Hollow. Lower, redder.\nThe walkers come up the pass road at night with their arms full, and go down empty.\nThe lamp battery is nearly gone. If I stop answering, Marta, it's the battery.\n- Emil"), at: (-47.70, -232.40), rot: 333.4, y: 8.5, name: "Ranger's log"),
        (kind: Note(text: "WEIR BOOK - KETTLE BECK\nLevel 0.62. Clear.\nLevel 0.60. Clear. The machines took the eel trap.\nLevel 0.61. The water tastes of pennies the day after a Surge, then it doesn't.\nLevel 0.58. Nobody to send these to. Writing them anyway."), at: (-100.30, 153.30), rot: 118.3, name: "Weir book"),
        (kind: Note(text: "Lorry 12, 15 Oct.\nStuck on the third bend with forty from Miners' Row in the back. Walked them over the pass on foot, the old ones on the soldiers' shoulders.\nLeft the lorry on the bend with the keys in. The machines had it by morning."), at: (-41.24, -126.97), rot: 50.3, name: "Lorry driver's note"),
        (kind: Note(text: "QUARRY PUMPS\nPit dry at 0600. Pumps one and two running.\nSince November the pit fills again every night, and the water comes up warm.\nTurned the pumps off. Whatever is down there, it wants to be under water. Let it."), at: (128.52, -47.50), rot: 212.7, name: "Quarry pumps note"),
        (kind: Note(text: "Lodge book.\nSnow on the saddle again. The machines walked the fence line all night, very slowly, as if counting the posts.\nIf you hear the hum, you're carrying too many of the bright stones. Put some down.\n- Fiala"), at: (205.30, -204.45), rot: 331.4, name: "Lodge book"),
        // notes:end
    ],

