// Kettle Pass — the second Zone.
//
// A mountain valley, 640 m on a side, climbing north. The truck drops you
// at the south fence, low in the valley; the land rises the whole way to
// the pass, a saddle between two summits in the north. The Kettle Beck
// runs down the valley from the old mine in the west to the farm fields
// in the south-east. The pass road switchbacks up the middle: walk it and
// you're seen from every slope, cut across and you climb.
//
//   North (-z)
//     the pass and the weather mast (RV), the ranger tower on the west
//     summit, the robot Gate in the north-west, the hunting lodge (RV)
//     on the east shoulder
//   Middle
//     Kettle mine and its railway (RV) in the west, the quarry pit
//     (artifacts) in the east, the switchbacks
//   South (+z)
//     insertion gate, Miners' Row in the kettle, the low farm,
//     the logging camp by the beck
//
// Coordinates: [x, z] metres, origin at centre, x east, +z south.
(
    name: "Kettle Pass",
    description: "A mining valley climbing to a high pass. Rock, pine, cloud on the tops, and the quarry that hums.",
    size: 640.0,
    cell: 1.0,
    base_height: 24.0,
    noise: (seed: 31, amplitude: 5.0, scale: 120.0, octaves: 5, detail: 0.35),
    rim: (width: 70.0, height: 16.0),
    fence_inset: 38.0,
    // Thin, cold mountain air.
    haze: Some((0.94, 0.98, 1.06)),
    // Gusts over bare rock, ravens, scree letting go somewhere up the slopes.
    sounds: (
        wind: "ambience/wind_mountain",
        birds: ["ambience/raven", "ambience/raven", "ambience/crow"],
        distant: ["ambience/rockfall"],
    ),

    features: [
        // The whole valley climbs north.
        Tilt(dir: (0.0, -1.0), rise_per_100m: 5.0),

        // The two summits either side of the pass.
        Hill(at: (-120.0, -235.0), radius: 95.0, height: 32.0),
        Hill(at: (140.0, -250.0), radius: 85.0, height: 26.0),
        // Valley walls.
        Ridge(points: [(-300.0, 200.0), (-275.0, 40.0), (-290.0, -140.0)], width: 110.0, height: 24.0),
        Ridge(points: [(300.0, 140.0), (275.0, -40.0), (290.0, -190.0)], width: 110.0, height: 20.0),
        // The mine hill, and the spoil heap below it.
        Hill(at: (-215.0, -85.0), radius: 75.0, height: 14.0),
        Hill(at: (-150.0, -95.0), radius: 25.0, height: 5.0),
        // The kettle: the bowl Miners' Row sits in.
        Hill(at: (0.0, 105.0), radius: 115.0, height: -7.0),
        // The quarry pit, blasted into the east slope.
        Hill(at: (185.0, -55.0), radius: 50.0, height: -13.0),
        // A knoll over the farm.
        Hill(at: (-140.0, 245.0), radius: 55.0, height: 6.0),

        // The beck's valley, then its bed.
        Channel(
            points: [(-330.0, -60.0), (-240.0, -30.0), (-160.0, 20.0), (-90.0, 70.0),
                     (-20.0, 105.0), (40.0, 130.0), (110.0, 165.0), (200.0, 190.0), (330.0, 205.0)],
            width: 80.0, depth: 3.0,
        ),
        Channel(
            points: [(-330.0, -60.0), (-240.0, -30.0), (-160.0, 20.0), (-90.0, 70.0),
                     (-20.0, 105.0), (40.0, 130.0), (110.0, 165.0), (200.0, 190.0), (330.0, 205.0)],
            width: 14.0, depth: 2.0,
        ),

        // Building pads.
        Plateau(polygon: [(-235.0, 150.0), (-140.0, 150.0), (-140.0, 225.0), (-235.0, 225.0)], blend: 18.0),
        Plateau(polygon: [(165.0, 215.0), (250.0, 215.0), (250.0, 262.0), (165.0, 262.0)], blend: 15.0),
        // The mine yard, cut into the hill a little below its average so
        // the roads up to it stay walkable.
        Plateau(polygon: [(-250.0, -115.0), (-160.0, -115.0), (-160.0, -25.0), (-250.0, -25.0)], height: Some(29.0), blend: 40.0),
        Plateau(polygon: [(165.0, -235.0), (255.0, -235.0), (255.0, -165.0), (165.0, -165.0)], blend: 20.0),
        // Pads at the pass: where the truck turns, and the mast's yard.
        Plateau(polygon: [(-12.0, -282.0), (32.0, -282.0), (32.0, -244.0), (-12.0, -244.0)], blend: 14.0),
        Plateau(polygon: [(48.0, -238.0), (88.0, -238.0), (88.0, -200.0), (48.0, -200.0)], blend: 12.0),
        Plateau(polygon: [(-70.0, -255.0), (-25.0, -255.0), (-25.0, -210.0), (-70.0, -210.0)], blend: 40.0),
        Plateau(polygon: [(-285.0, -285.0), (-215.0, -285.0), (-215.0, -225.0), (-285.0, -225.0)], blend: 15.0),
        // Pads for the small places between the big ones.
        Plateau(polygon: [(-110.0, 146.0), (-88.0, 146.0), (-88.0, 162.0), (-110.0, 162.0)], blend: 12.0),
        Plateau(polygon: [(60.0, 206.0), (88.0, 206.0), (88.0, 234.0), (60.0, 234.0)], blend: 12.0),
        Plateau(polygon: [(-52.0, -142.0), (-28.0, -142.0), (-28.0, -118.0), (-52.0, -118.0)], blend: 12.0),
        Plateau(polygon: [(108.0, -148.0), (130.0, -148.0), (130.0, -128.0), (108.0, -128.0)], blend: 12.0),
        Plateau(polygon: [(114.0, -52.0), (136.0, -52.0), (136.0, -32.0), (114.0, -32.0)], blend: 12.0),
    ],

    roads: [
        // The pass road: from the south gate down into the kettle, over
        // the beck, through Miners' Row and up the switchbacks to the pass.
        (
            name: "Pass road", kind: Asphalt, width: 6.5, smoothing: 20.0,
            points: [(120.0, 330.0), (120.0, 270.0), (100.0, 200.0), (60.0, 150.0), (20.0, 110.0),
                     (-20.0, 60.0), (30.0, 20.0), (-15.0, -30.0), (40.0, -80.0), (0.0, -130.0),
                     (25.0, -185.0), (10.0, -250.0), (10.0, -330.0)],
            bridges: [(at: (40.0, 130.0), length: 32.0)],
