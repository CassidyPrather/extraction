        // Down the valley to the low farm.
        (
            name: "Farm lane", kind: Dirt, width: 4.0,
            points: [(-12.0, 143.0), (-60.0, 155.0), (-110.0, 170.0), (-165.0, 185.0)],
        ),
        // Along the beck to the logging camp.
        (
            name: "Camp road", kind: Gravel, width: 5.0,
            points: [(112.0, 240.0), (150.0, 242.0), (195.0, 238.0)],
        ),
        // Off the switchbacks, across the slope to the lodge.
        (
            name: "Lodge track", kind: Gravel, width: 4.0, smoothing: 20.0,
            points: [(40.0, -80.0), (100.0, -110.0), (150.0, -150.0), (200.0, -195.0)],
        ),
        // The camp's old track: over the beck at the ford and up the east
        // bank to the quarry. The far side of the valley from the road.
        (
            name: "Camp ford", kind: Dirt, width: 3.5, smoothing: 10.0,
            points: [(195.0, 238.0), (200.0, 205.0), (205.0, 182.0), (200.0, 140.0), (185.0, 80.0),
                     (172.0, 20.0), (170.0, -16.0)],
        ),
        // The quarry haul road.
        (
            name: "Quarry road", kind: Dirt, width: 4.5, smoothing: 15.0,
            points: [(30.0, 20.0), (90.0, 0.0), (140.0, -30.0), (143.0, -32.0)],
        ),
        // The mine's own road, up from the switchbacks.
        (
            name: "Mine road", kind: Gravel, width: 4.5, smoothing: 45.0,
            points: [(-15.0, -30.0), (-80.0, -45.0), (-140.0, -55.0), (-185.0, -60.0)],
        ),
        // The narrow-gauge railway from the mine head down the hill.
        (
            name: "Mine railway", kind: Rail, width: 3.0, smoothing: 90.0,
            points: [(-235.0, -55.0), (-160.0, -38.0), (-110.0, -15.0), (-107.0, -12.5)],
        ),
        // The miners' old way to work: Row to the mine, over the beck.
        (
            name: "Mine path", kind: Path, width: 1.6, shoulder: 1.0, smoothing: 4.0,
            // The footbridge and its approaches are one straight line: a deck
            // on a curve had routes stepping off its end into the rail.
            points: [(-46.0, 119.0), (-85.0, 95.0), (-112.1, 77.5), (-116.1, 63.1), (-123.9, 34.1),
                     (-127.9, 19.6), (-150.0, 8.0), (-180.0, 1.0), (-205.0, -10.0),
                     (-222.0, -26.0)],
            bridges: [(at: (-120.0, 48.6), length: 30.0)],
        ),
        // The quarrymen's way home: round the pit's east lip and up to the
        // lodge, the back way to the east shoulder.
        (
            name: "Quarrymen's path", kind: Path, width: 1.6, shoulder: 1.0, smoothing: 4.0,
            points: [(142.0, -31.0), (170.0, -18.0), (198.0, -16.0), (222.0, -40.0), (226.0, -86.0),
                     (226.0, -122.0), (222.0, -165.0)],
        ),
        // Footpaths from the pass road to the small places beside it.
        (
            name: "Hut path", kind: Path, width: 1.6, shoulder: 1.0, smoothing: 4.0,
            points: [(1.0, -129.0), (-18.0, -130.0), (-34.0, -129.0)],
        ),
        // Up from the pass to the ranger tower on the west summit.
        (
            name: "Tower path", kind: Path, width: 1.4, shoulder: 0.8, smoothing: 4.0,
            points: [(9.0, -246.0), (-14.0, -242.0), (-32.0, -238.0), (-45.0, -233.0)],
        ),
    ],

