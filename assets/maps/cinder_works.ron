            points: [(-60.0, 160.0), (-140.0, 128.0), (-205.0, 112.0)],
        ),
        // The works railway, in from the east to the rail shed.
        (
            name: "Works railway", kind: Rail, width: 3.0, smoothing: 40.0,
            points: [(330.0, -5.0), (250.0, -5.0), (190.0, 2.0), (152.0, 5.0)],
        ),
        // The towpath along the south bank.
        (
            name: "Towpath", kind: Path, width: 1.6, shoulder: 0.8, smoothing: 4.0,
            points: [(-250.0, 74.0), (-150.0, 70.0), (-40.0, 67.0), (10.0, 66.0)],
        ),
    ],

    water: [
        (
            name: "The canal", width: 11.0, depth: 1.4,
            points: [(-330.0, 65.0), (-150.0, 60.0), (0.0, 56.0), (150.0, 51.0), (330.0, 45.0)],
