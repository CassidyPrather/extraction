// Cinder Works — the third Zone.
//
// A burnt industrial valley, 640 m on a side, nearly flat. The works sit
// in the middle: the foundry hall, the garage, the rail shed and the
// chimney you can see from anywhere the fog allows. A canal cuts the
// valley west to east; the works road crosses it on the one bridge. The
// north-west burned years ago and is still standing dead; the slag heaps
// in the north-east are where the artifacts are, and where the robots
// come and go.
//
//   North (-z)
//     the burnt Cinder wood and the fire lookout (RV) in the west, the
//     north sidings (RV), the slag heaps (artifacts) and the robot Gate
//     in the east
//   Middle
//     the canal; the works (foundry hall, garage, chimney, rail shed),
//     the works yard (RV) at the railway's east end, the ash pit
//     (artifacts) in the west
//   South (+z)
//     insertion gate, Ash Row (the workers' houses), Cutter's farm
//
// Coordinates: [x, z] metres, origin at centre, x east, +z south.
(
    name: "Cinder Works",
    description: "A burnt-out works on a canal. Brick, slag and standing dead wood, and the chimney over all of it.",
    size: 640.0,
    cell: 1.0,
    base_height: 22.0,
    noise: (seed: 61, amplitude: 3.0, scale: 110.0, octaves: 5, detail: 0.3),
    rim: (width: 70.0, height: 14.0),
    fence_inset: 38.0,
    // Ash-brown air, and ash still drifting down when it isn't raining.
    haze: Some((1.12, 0.95, 0.80)),
    ash: 0.6,
    // Wind through scaffolding and sheet roofs; jackdaws in the chimneys.
    sounds: (
        wind: "ambience/wind_works",
        birds: ["ambience/jackdaw", "ambience/jackdaw", "ambience/crow"],
    ),

    features: [
        // A gentle fall toward the canal from both sides.
        Tilt(dir: (0.0, -1.0), rise_per_100m: 1.5),

        // The slag heaps, tipped over decades.
        Hill(at: (200.0, -150.0), radius: 48.0, height: 15.0),
        Hill(at: (245.0, -105.0), radius: 30.0, height: 9.0),
        Hill(at: (155.0, -195.0), radius: 30.0, height: 10.0),
        // The ash pit: where the works dumped its ash, a sunken bowl.
        Hill(at: (-200.0, 0.0), radius: 42.0, height: -6.0),
        // A low rise the lookout stands on.
        Hill(at: (-175.0, -165.0), radius: 55.0, height: 7.0),
        // Valley sides.
        Ridge(points: [(-300.0, 220.0), (-285.0, 0.0), (-295.0, -200.0)], width: 100.0, height: 14.0),
        Ridge(points: [(300.0, 220.0), (290.0, 60.0), (300.0, -60.0)], width: 90.0, height: 12.0),

        // The canal's cut, then its bed.
        Channel(points: [(-330.0, 65.0), (-150.0, 60.0), (0.0, 56.0), (150.0, 51.0), (330.0, 45.0)],
                width: 40.0, depth: 1.2),
        Channel(points: [(-330.0, 65.0), (-150.0, 60.0), (0.0, 56.0), (150.0, 51.0), (330.0, 45.0)],
                width: 16.0, depth: 2.5),

        // Building pads.
        Plateau(polygon: [(-120.0, 110.0), (12.0, 110.0), (12.0, 200.0), (-120.0, 200.0)], blend: 15.0),
        Plateau(polygon: [(-45.0, -60.0), (120.0, -60.0), (120.0, 22.0), (-45.0, 22.0)], blend: 18.0),
        Plateau(polygon: [(125.0, -15.0), (200.0, -15.0), (200.0, 40.0), (125.0, 40.0)], blend: 12.0),
        Plateau(polygon: [(-265.0, 80.0), (-190.0, 80.0), (-190.0, 145.0), (-265.0, 145.0)], blend: 15.0),
        Plateau(polygon: [(40.0, -275.0), (115.0, -275.0), (115.0, -225.0), (40.0, -225.0)], blend: 14.0),
        Plateau(polygon: [(222.0, -5.0), (275.0, -5.0), (275.0, 30.0), (222.0, 30.0)], blend: 12.0),
        Plateau(polygon: [(-285.0, -285.0), (-215.0, -285.0), (-215.0, -225.0), (-285.0, -225.0)], blend: 15.0),
        Plateau(polygon: [(215.0, -285.0), (285.0, -285.0), (285.0, -225.0), (215.0, -225.0)], blend: 15.0),
    ],

    roads: [
        // The works road: from the gate through Ash Row, over the canal,
        // past the works and on north to the old sidings.
        (
            name: "Works road", kind: Asphalt, width: 7.0, smoothing: 20.0,
            points: [(-110.0, 330.0), (-110.0, 270.0), (-95.0, 210.0), (-60.0, 160.0), (-10.0, 110.0),
