        (kind: Poi, at: (75.0, -240.0), name: "North sidings"),
        // notes:begin (generated by scripts/place_notes.py)
        (kind: Terminal(pages: ["WORKS FOREMAN - LOG\n\nWe fed the furnace what the\nmachines brought in. Scrap,\ncars, furniture. They brought\nmore every day.", "Then the fire got into the\nvalley and didn't go out. The\nAuthority took the works keys\nand the depot key away.\n\nKEY-C is in the strongbox at\nthe foot of the chimney."]), at: (62.80, -13.00), rot: -119.8, name: "Foreman's terminal"),
        (kind: Terminal(pages: ["CUSTODIAN NETWORK - CINDER\n\nDepot GATE-C: ACTIVE\nMode: SWEEP (heat damage)\n\nRecall requires KEY-M, KEY-K,\nKEY-C at any depot lock."]), at: (-26.50, -17.80), rot: -152.0, name: "Garage terminal"),
        (kind: Note(text: "The ash doesn't stop. It isn't from the fire any more. It comes out of the ground near the slag heaps. The works chimney is the best landmark: walk toward it in the fog and you'll find the road."), at: (-109.20, 173.30), rot: 205.2, name: "Foreman's house note"),
        (kind: Note(text: "If you're reading this you came in on the driver's truck. He's all right. He won't come past the fence.\nPull the cord in the back when you want out. Don't be late for the Surge."), at: (-0.70, 151.30), rot: 28.3, name: "House note"),
        // notes:end
