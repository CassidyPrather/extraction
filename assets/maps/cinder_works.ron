        (kind: Loot(table: "workshop"), at: (-232.0, 140.0), name: "Cutter's workshop"),
        // notes:begin (generated by scripts/place_notes.py)
        (kind: Note(text: "SOUTH GATE, CINDER - DUTY LOG\n19 Feb. Fire in the north-west wood since the 12th. The works still burning loads; machines in from the Gate every hour.\n26 Feb. Wind turned. Ash on everything. The rations taste of it.\n1 Apr. Review postponed. We stand down. The inspector stays: says he'll wait for them in the works garage."), at: (-102.80, 285.30), rot: 63.4, name: "Gate log"),
        (kind: Terminal(pages: ["WORKS LOG - R. KRAL\n\nAuthority contract: burn all\nmaterial the machines deliver.\n\nNov: cars, bedding, furniture.\nDec: more. Toys. A piano.\nJan: we stopped asking.", "12 Feb. Furnace three blew\nback into the yard. The wood\ncaught by evening.\n\nThe machines kept delivering\nall through the fire.", "The inspector locked the\nCinder depot key in the\nstrongbox at the foot of the\nchimney, and kept our keys.\n\nKEY-C is down there still.\nHe sits in the garage with\nthe radio, waiting."]), at: (62.80, -13.00), rot: -119.8, name: "Foreman's terminal"),
        (kind: Terminal(pages: ["CUSTODIAN NETWORK - CINDER\n\nDepot GATE-C: ACTIVE\nMode: SWEEP (heat damage)\n\nRecall requires KEY-M, KEY-K,\nKEY-C at any depot lock.", "SESSION LOG\n\nP.RUS   status       ACTIVE\nP.RUS   review date  NOT SET\nP.RUS   review date  NOT SET\nP.RUS   review date  NOT SET\nP.RUS   recall       KEYS 0/3\n\nNo session since 9 JUN."]), at: (-26.50, -17.80), rot: -152.0, name: "Garage terminal"),
        (kind: Note(text: "Ruben says the ash is from the fire. The fire was out by March. I sweep the step every morning, and every morning there's more, and it isn't coming down. It's coming up, out of the cracks, worst by the slag heaps.\nThe chimney is the best landmark: walk toward it in the fog and you'll find the road.\n- V."), at: (-109.20, 173.30), rot: 205.2, name: "Foreman's house note"),
        (kind: Note(text: "Came in on the driver's truck, same as you, I expect. He's all right. He won't come past the fence. I asked him why once. He said he tried, the first day, and they turned him back, and now he's used to it.\nPull the cord in the back when you want out. Don't be late for the Surge.\nHe keeps a count of us. Don't add to it."), at: (-0.70, 151.30), rot: 28.3, name: "House note"),
        (kind: Note(text: "FIRE LOOKOUT - CINDER, 12 FEB\n1540. Black smoke, works yard.\n1610. Flame in the north-west wood. Phoned the works. No answer.\n1700. Wind south-east. Lamp to Marrow and Kettle: three short.\n2300. Machines walking into the fire with their arms full, and out empty.\nMarta answered. Kettle didn't."), at: (-177.70, -167.40), rot: 333.4, y: 8.5, name: "Lookout log"),
        (kind: Note(text: "SLUICE HOUSE - ASH PIT\nWorks order: drain the pit to the canal.\nThe pit won't drain. The ash floats. It drifts against the current, back toward the slag heaps.\nSluice shut. I'm not opening it again."), at: (-166.20, 29.00), rot: 242.7, name: "Sluice house note"),
        (kind: Terminal(pages: ["RELAY LOG - MAST C3\n\nHeat damage: housing, cabling.\nPylon reports: degraded.\nRepair requested: 1 FEB.\nRepair requested: 1 MAR.\nRepair requested: 1 APR.\n...\n\nRequests held for uplink."]), at: (96.03, -236.76), rot: 140.3, name: "Mast terminal"),
        (kind: Note(text: "Woodward's book, last page.\nThe works' smoke came down the valley at noon and didn't lift. I've wet the roof and the woodpile and I'm stopping here.\nMatches by the stove. The door sticks, kick it at the bottom, then wedge it.\n- T. Vesely, woodward"), at: (-74.80, -158.41), rot: 341.4, name: "Woodward's book"),
        // notes:end
    ],

