        (prefab: "fence_garden", at: (127.4, 74.8), rot: 0.0),
        (prefab: "fence_garden", at: (131.7, 79.0), rot: 270.0),
        (prefab: "fence_garden", at: (131.7, 87.5), rot: 270.0),

        // Car wrecks (Destruction strips their doors, bonnets, boots and
        // wheels): cover on the verges, never on the road.
        // The queue for the gate, the morning it shut: three facing south,
        // run into each other and left on the west verge.
        // Pulled over north of the logging-road turn: the one thing to
        // crouch behind between the turn and the village birches.
        // The farm's own jeep, in the yard by the shed.
        (prefab: "wreck_uaz", at: (95.0, 94.8), rot: 75.0),

        // Cover within a four-second sprint of every step of the first jobs
        // (map_lint FIRST_RUN): cars abandoned on the verges in the
        // evacuation, and log piles stacked by the ways across the open.
    ],

