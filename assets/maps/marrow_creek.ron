// Marrow Creek — the first Zone.
//
// A forested river valley, 640 m on a side. The truck drops you at the
// south fence; the rendezvous points are all across the creek on the north
// side. The creek is the spine of the map: three ways across (the road
// bridge in the village, the ford below the farm, the rail trestle in the
// north-west), each with a different risk.
//
//   North (-z)
//     rail line, rail yard (RV), bus depot (RV), radio-mast hill,
//     the robot Gate in the north-west corner, ranger tower (RV)
//   Middle
//     the creek, the village and its bridge, the pumping station,
//     the Hollow (anomaly crater, artifacts)
//   South (+z)
//     insertion gate, logging camp, the old farm and its fields
//
// Coordinates: [x, z] metres, origin at centre, x east, +z south.
(
    name: "Marrow Creek",
    description: "A quarantined river valley. Spruce, birch, rain, and something in the Hollow.",
    size: 388.0,
    cell: 1.0,
    base_height: 20.0,
    noise: (seed: 7, amplitude: 4.0, scale: 140.0, octaves: 5, detail: 0.3),
    rim: (width: 70.0, height: 11.0),
    // The quarantine fence runs this far in from the map edge.
    fence_inset: 38.0,

    features: [
        // The valley falls gently from north-west to south-east.
        Tilt(dir: (1.0, 0.6), rise_per_100m: -1.6),

        // Radio-mast hill: the landmark you can see through the fog.
        Hill(at: (-54.0, -78.8), radius: 66.0, height: 12.1),
        Hill(at: (-31.0, -128.0), radius: 33.0, height: 6.6),
        // Western ridge above the pumping station.
        Ridge(points: [(-180.0, 50.1), (-140.4, -24.6), (-149.5, -66.3)], width: 49.5, height: 8.8),
        // Low hills around the farm fields, so they feel like a bowl.
        Hill(at: (154.0, 99.4), radius: 44.0, height: 5.5),
        Hill(at: (64.3, 106.2), radius: 27.5, height: 3.3),
        // Eastern high ground over the Hollow.
        Hill(at: (144.1, -64.9), radius: 46.8, height: 9.9),
        // The Hollow: a bowl blown into the hillside.
        Hill(at: (82.5, -22.0), radius: 30.3, height: -6.1),
        // Logging-camp knoll.
        Hill(at: (-100.8, 108.5), radius: 38.5, height: 3.9),
        // Rises round the Village that keep its fields out of the machines'
        // sight and its fights out of their hearing (map_openness; the
        // playtest of 28 October: "a couple of points in an otherwise
        // empty plane", "gunfights ... attract the entirety of the
        // robots"). The bank rise north of the creek, between the Village
        // and the north bank's work site and spotter;
        // the ford rise east, between the Village and the ford field;
        // the clearing rise west, between the Village and the forest
        // clearing's site.
        // The spotter's rise east of the district road north of the creek,
        // between the road and the Bank spotter;
        // the lane bank west of the road south of the Village, the fields
        // to the gate;
        // and the rail yard's spoil heap, the ballast left in a hill.

        // The creek valley. Wide, gentle valley first, then the bed.
        Channel(
            points: [(-181.5, -33.0), (-160.0, -34.7), (-80.0, -25.0), (-40.0, -14.0),
                     (-21.7, -15.3), (30.6, -13.2), (55.2, 25.8), (104.7, 28.9), (181.5, 38.5)],
            width: 60.5, depth: 2.2,
        ),
        Channel(
            points: [(-181.5, -33.0), (-160.0, -34.7), (-80.0, -25.0), (-40.0, -14.0),
                     (-21.7, -15.3), (30.6, -13.2), (55.2, 25.8), (104.7, 28.9), (181.5, 38.5)],
            width: 8.8, depth: 1.2,
        ),

        // Building pads.
        Plateau(polygon: [(-124.6, 68.5), (-55.8, 63.5), (-55.8, 123.5), (-125.8, 123.5)], blend: 16.5),
        Plateau(polygon: [(59.0, 54.8), (129.0, 54.8), (129.0, 109.8), (59.0, 109.8)], blend: 11.0),
        Plateau(polygon: [(-135.0, -5.9), (-85.0, -5.9), (-85.0, 30.1), (-135.0, 30.1)], blend: 16.5),
        Plateau(polygon: [(44.0, -136.0), (159.0, -133.1), (158.5, -72.8), (52.8, -88.1)], blend: 13.8),
        Plateau(polygon: [(-21.2, -137.0), (43.8, -137.0), (43.8, -92.3), (-21.2, -92.6)], blend: 11.0),
        Plateau(polygon: [(-146.0, -86.1), (-137.5, -100.5), (-139.5, -76.3), (-161.3, -73.5)], blend: 11.0),
        Plateau(polygon: [(-175.9, -173.1), (-107.0, -174.1), (-107.0, -114.1), (-177.0, -114.1)], blend: 8.2),
        // The survey post's pad on the Hollow's north rim.
        Plateau(polygon: [(28.8, 5.8), (42.5, 8.0), (43.6, 22.8), (36.6, 14.4)], blend: 6.6),
    ],

    roads: [
        // The old district road: south gate, through the farm turn-off,
        // into the village, over the bridge, north to the bus depot.
        (
            name: "District road", kind: Asphalt, width: 7.0, smoothing: 25.0,
            points: [(22.0, 207.3), (22.0, 148.5), (13.5, 89.3), (7.6, 97.2), (-2.2, 48.5),
                     (2.8, 8.5), (9.2, -21.6), (8.2, -22.0), (2.8, -60.5), (3.8, -67.1),
                     (13.8, -107.0), (13.8, -198.4)],
            bridges: [(at: (8.6, -20.2), length: 28.0)],
        ),
        // Farm lane east off the district road.
        (
            name: "Farm lane", kind: Dirt, width: 4.0,
            points: [(13.9, 94.2), (44.0, 96.3), (59.0, 89.8), (94.0, 84.8)],
        ),
        // Logging road west through the forest.
        (
