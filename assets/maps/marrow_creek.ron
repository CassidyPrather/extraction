// Marrow Creek — the first Zone.
//
// A forested river valley, 640 m on a side. The truck drops you at the
// south fence; the rendezvous points are all across the creek on the north
// side. The creek is the spine of the map: three ways across (the road
// bridge in the village, the ford below the farm, the rail trestle in the
// north-west), each with a different risk.
//
//   North (-z)
//     rail line, rail yard (RV), bus depot (RV), radio-mast hill,
//     the robot Gate in the north-west corner, ranger tower (RV)
//   Middle
//     the creek, the village and its bridge, the pumping station,
//     the Hollow (anomaly crater, artifacts)
//   South (+z)
//     insertion gate, logging camp, the old farm and its fields
//
// Coordinates: [x, z] metres, origin at centre, x east, +z south.
(
    name: "Marrow Creek",
    description: "A quarantined river valley. Spruce, birch, rain, and something in the Hollow.",
    size: 640.0,
    cell: 1.0,
    base_height: 20.0,
    noise: (seed: 7, amplitude: 4.0, scale: 140.0, octaves: 5, detail: 0.3),
    rim: (width: 70.0, height: 11.0),
    // The quarantine fence runs this far in from the map edge.
    fence_inset: 38.0,

    features: [
        // The valley falls gently from north-west to south-east.
        Tilt(dir: (1.0, 0.6), rise_per_100m: -1.6),

        // Radio-mast hill: the landmark you can see through the fog.
        Hill(at: (-120.0, -175.0), radius: 95.0, height: 30.0),
        Hill(at: (-60.0, -230.0), radius: 60.0, height: 12.0),
        // Western ridge above the pumping station.
        Ridge(points: [(-270.0, 60.0), (-230.0, -20.0), (-235.0, -110.0)], width: 90.0, height: 16.0),
        // Low hills around the farm fields, so they feel like a bowl.
        Hill(at: (250.0, 170.0), radius: 80.0, height: 10.0),
        Hill(at: (90.0, 220.0), radius: 50.0, height: 6.0),
        // Eastern high ground over the Hollow.
        Hill(at: (240.0, -110.0), radius: 90.0, height: 18.0),
        // The Hollow: a bowl blown into the hillside.
        Hill(at: (150.0, -40.0), radius: 55.0, height: -11.0),
        // Logging-camp knoll.
        Hill(at: (-175.0, 185.0), radius: 70.0, height: 7.0),

        // The creek valley. Wide, gentle valley first, then the bed.
        Channel(
            points: [(-330.0, -60.0), (-250.0, -25.0), (-170.0, -15.0), (-90.0, 10.0),
                     (-20.0, 15.0), (40.0, 5.0), (110.0, 30.0), (190.0, 55.0), (330.0, 70.0)],
            width: 110.0, depth: 4.0,
        ),
        Channel(
            points: [(-330.0, -60.0), (-250.0, -25.0), (-170.0, -15.0), (-90.0, 10.0),
                     (-20.0, 15.0), (40.0, 5.0), (110.0, 30.0), (190.0, 55.0), (330.0, 70.0)],
            width: 16.0, depth: 2.2,
        ),

        // Building pads.
        Plateau(polygon: [(-200.0, 140.0), (-130.0, 140.0), (-130.0, 200.0), (-200.0, 200.0)], blend: 18.0),
        Plateau(polygon: [(140.0, 120.0), (210.0, 120.0), (210.0, 175.0), (140.0, 175.0)], blend: 20.0),
        Plateau(polygon: [(-225.0, 4.0), (-175.0, 4.0), (-175.0, 40.0), (-225.0, 40.0)], blend: 30.0),
        Plateau(polygon: [(120.0, -235.0), (250.0, -235.0), (250.0, -175.0), (120.0, -175.0)], blend: 25.0),
        Plateau(polygon: [(-10.0, -245.0), (55.0, -245.0), (55.0, -200.0), (-10.0, -200.0)], blend: 20.0),
        Plateau(polygon: [(-255.0, -150.0), (-225.0, -150.0), (-225.0, -120.0), (-255.0, -120.0)], blend: 20.0),
        Plateau(polygon: [(-285.0, -285.0), (-215.0, -285.0), (-215.0, -225.0), (-285.0, -225.0)], blend: 15.0),
    ],

    roads: [
        // The old district road: south gate, through the farm turn-off,
        // into the village, over the bridge, north to the bus depot.
        (
            name: "District road", kind: Asphalt, width: 7.0, smoothing: 25.0,
            points: [(40.0, 330.0), (40.0, 270.0), (30.0, 200.0), (10.0, 130.0), (0.0, 80.0),
