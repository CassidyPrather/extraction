        (kind: Loot(table: "workshop"), at: (-178.0, 152.0), name: "Sawmill lock-up"),
        (kind: Loot(table: "tools"), at: (-162.0, 182.0), name: "Logger's chest"),
        (kind: Loot(table: "medical"), at: (-188.0, 34.0), name: "Pump keeper's store"),
        (kind: Loot(table: "ammo_common"), at: (-172.0, -36.0), name: "Footbridge cache"),
        (kind: Loot(table: "ammo_common"), at: (-246.0, -124.0), name: "Ranger's ammo box"),
        (kind: Loot(table: "driver_cache"), at: (132.0, -232.0), name: "Driver's cache"),
        // notes:begin (generated by scripts/place_notes.py)
        (kind: Note(text: "Anna -\nThey said three days. The buses left at six. I stayed for the dog.\nThe white machines came out of the Gate the next morning and started tidying. They took the bins. They took the bicycles. They took Mr Holm.\nKeep still when the little flying one looks at you. It sees you move."), at: (-17.30, 93.70), rot: 208.3, name: "Village note"),
        (kind: Note(text: "POST OFFICE - UNDELIVERED\nTo the station chief, Hollow survey post. Your lockbox key for the Marrow depot is to stay with you. Do not leave it at the post. The Authority will collect all three keys at the review.\n- Quarantine Authority, valley office"), at: (-19.20, 63.30), rot: 205.2, name: "Post office letter"),
        (kind: Note(text: "Walkers:\nDon't waste rounds on the shell. The eye under the front plate, or the knees. They go down like a felled tree.\nThe flyers are glass and wire. One good hit.\nAnd never shoot near the well. It doesn't like it.\n- J."), at: (-184.70, 190.55), rot: 331.4, name: "Foreman's note"),
        (kind: Note(text: "The well in the village takes what you give it. Food, scrap, the bright stones. Sometimes it gives back: a calm hour, a whisper of where things are. Sometimes nothing.\nDon't give it your gun."), at: (-194.20, 19.00), rot: 242.7, name: "Pump station note"),
        (kind: Terminal(pages: ["QUARANTINE AUTHORITY\nCUSTODIAN NETWORK - MARROW\n\nDepot GATE-M: ACTIVE\nMode: SWEEP\nUnits: survey, haul, build,\n       recover\n\nThe Custodian keeps the valley\nclean until the review.", "DEPOT ACCESS\n\nThe depots answer only to the\nAuthority. Recall needs the\nthree valley keys, presented\ntogether at any depot lock:\n\n  KEY-M  Marrow  (Hollow post)\n  KEY-K  Kettle  (quarry)\n  KEY-C  Cinder  (the works)", "REVIEW STATUS\n\nReview date: (not set)\nAuthority staff on site: 0\n\nCustodian continues SWEEP until\nrecalled."]), at: (37.20, -218.50), rot: 118.0, name: "Depot office terminal"),
        (kind: Terminal(pages: ["RELAY LOG - MAST M1\n\nPylons extend the Custodian's\neyes: each one reports what\nmoves near it, and the depot\nsends a team.\n\nPylon down = reports stop.", "SWEEP SCHEDULE\n\nField discharge (\"SURGE\") every\ncycle. Clears contamination.\nPersonnel: be under a roof or\nout of the valley. Loose\nmaterial is reset."]), at: (-112.01, -158.39), rot: -179.7, name: "Mast terminal"),
        (kind: Note(text: "From up here you can see the Hollow glow after dark. The survey team went in with the chief's lockbox and came back without the chief. The box is still down there, where the ground lifts. Bring a light. Don't run."), at: (-239.70, -137.40), rot: 333.4, y: 8.5, name: "Ranger's note"),
        // notes:end
    ],

