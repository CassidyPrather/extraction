            points: [(28.0, 190.0), (80.0, 175.0), (140.0, 155.0), (175.0, 150.0)],
        ),
        // Logging road west through the forest.
        (
            name: "Logging road", kind: Gravel, width: 5.0,
            points: [(20.0, 160.0), (-40.0, 165.0), (-110.0, 175.0), (-165.0, 170.0)],
        ),
        // Village to pumping station along the south bank.
        (
            name: "Station road", kind: Gravel, width: 5.0,
            points: [(2.0, 60.0), (-60.0, 45.0), (-120.0, 30.0), (-170.0, 25.0), (-187.0, 22.5)],
        ),
        // Farm track down to the ford and up the far side to the Hollow and the rail yard.
        (
            name: "Ford track", kind: Dirt, width: 3.5, smoothing: 10.0,
            points: [(175.0, 140.0), (160.0, 90.0), (150.0, 45.0), (150.0, 15.0), (175.0, -60.0),
                     (190.0, -130.0), (185.0, -190.0)],
        ),
        // Service road from the bus depot to the radio mast.
        (
            name: "Mast road", kind: Gravel, width: 4.0, smoothing: 30.0,
            points: [(15.0, -170.0), (-30.0, -165.0), (-75.0, -175.0), (-110.0, -170.0)],
        ),
        // Rail line across the north, past the rail yard and the robot
        // Gate, over the creek on a trestle in the far west.
        (
            name: "Rail line", kind: Rail, width: 4.0, smoothing: 60.0,
            points: [(-330.0, -150.0), (-280.0, -165.0), (-200.0, -235.0), (-120.0, -255.0),
                     (0.0, -258.0), (120.0, -245.0), (200.0, -215.0), (330.0, -200.0)],
        ),
        // Footpath from the logging camp up through the trees, over the
        // creek on the pumping station's footbridge, and on up through the
        // pines to the mast road.
        (
            name: "Forest path", kind: Path, width: 1.6, shoulder: 1.0, smoothing: 4.0,
            points: [(-160.0, 140.0), (-175.0, 90.0), (-185.0, 45.0), (-180.0, 8.0),
                     (-178.0, -16.0), (-178.0, -30.0), (-165.0, -70.0), (-150.0, -110.0),
                     (-125.0, -150.0)],
            bridges: [(at: (-178.0, -16.0), length: 24.0)],
        ),
    ],

    water: [
