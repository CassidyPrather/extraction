            points: [(-85.7, 63.5), (-86.7, 67.0), (-88.6, 64.9), (-95.0, 35.1), (-90.0, -1.9),
                     (-88.9, -15.1), (-89.9, -17.0), (-77.6, -49.1), (-56.2, -41.7), (-38.6, -26.3)],
            bridges: [(at: (-88.5, -25.5), length: 24.0)],
        ),
    ],

