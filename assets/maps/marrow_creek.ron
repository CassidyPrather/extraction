        (
            name: "Rail line", kind: Rail, width: 4.0, smoothing: 90.0,
            points: [(-330.0, -150.0), (-280.0, -165.0), (-200.0, -235.0), (-120.0, -255.0),
                     (0.0, -258.0), (120.0, -245.0), (200.0, -215.0), (330.0, -200.0)],
        ),
        // Footpath from the logging camp up through the trees, over the
