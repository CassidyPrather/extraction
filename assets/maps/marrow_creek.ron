        ),
        // Village to pumping station along the south bank.
        (
            name: "Station road", kind: Gravel, width: 5.0,
            points: [(-0.2, 28.5), (-53.4, 16.9), (-30.0, 20.1), (-80.0, 15.1), (-97.0, 12.6)],
        ),
        // Farm track down to the ford and up the far side to the Hollow and the rail yard.
        (
            name: "Ford track", kind: Dirt, width: 3.5, smoothing: 10.0,
            points: [(94.0, 74.8), (79.2, 25.3), (82.5, 30.7), (82.5, 33.0), (110.5, 6.0),
                     (130.5, -42.0), (112.4, -65.5), (103.3, -60.9), (95.0, -88.8)],
        ),
        // Service road from the bus depot to the radio mast.
        (
            name: "Mast road", kind: Gravel, width: 4.0, smoothing: 35.0,
            points: [(3.8, -67.1), (-11.1, -68.5), (-17.2, -66.7), (-23.4, -38.0),
                     (-37.4, -24.7), (-55.9, -49.4), (-72.3, -65.0), (-81.2, -80.6),
                     (-85.9, -85.8), (-83.0, -87.8), (-72.0, -94.8), (-62.0, -94.8),
                     (-54.0, -83.8)],
        ),
        // The ranger's path: off the forest path at the footbridge, north
        // under the ridge to the tower. With the logging road and the forest
        // path it makes the west way to the ranger tower rendezvous: camp,
        // pumping station, tower.
        (
            name: "Ranger's path", kind: Path, width: 1.6, shoulder: 1.0, smoothing: 4.0,
            points: [(-91.2, -20.3), (-94.3, -45.1), (-106.1, -56.1), (-110.5, -74.3), (-126.5, -84.3),
                     (-140.5, -87.3)],
        ),
        // The haulers' track: from the Gate down to the Depot's intake ramp,
        // worn by the convoys.
        (
            name: "Haulers' track", kind: Dirt, width: 4.0, smoothing: 10.0,
            points: [(-138.0, -136.1), (-130.0, -132.1), (-123.0, -129.1)],
        ),
        // Rail line across the north, past the rail yard and the robot
        // Gate, over the creek on a trestle in the far west.
        (
            name: "Rail line", kind: Rail, width: 4.0, smoothing: 90.0,
            points: [(-181.5, -82.5), (-155.6, -88.4), (-92.0, -124.1), (-62.2, -146.1),
                     (-11.2, -150.0), (47.7, -143.2), (110.0, -113.8), (181.5, -110.0)],
        ),
        // Footpath from the logging camp up through the trees, over the
        // creek on the pumping station's footbridge, and on up through the
        // pines to the mast road.
        // On from the forest path's end to the district road under the
        // mast: the pumping station's second way home, to the Bus depot.
        // The Old farm's track to the checkpoint, across the field past its
        // wood stores and field shed: the first job's walk, where its cover
        // stands, the farm's water tower ahead from the first step (the
        // road north hid the farm lane's turn, and the designer's first
        // raid walked on past it to the Village).
        (
            name: "Farm track", kind: Dirt, width: 3.0, smoothing: 8.0,
            points: [(31.0, 137.5), (52.0, 140.5), (80.0, 135.0), (71.2, 130.1), (70.2, 122.4),
                     (60.5, 124.8), (61.0, 116.8), (74.0, 100.8), (85.0, 86.8)],
        ),
        (
            name: "Pump path", kind: Path, width: 1.6, shoulder: 1.0, smoothing: 4.0,
            points: [(-38.6, -26.3), (-22.2, -30.6), (-10.1, -52.6), (-16.9, -78.9), (-14.0, -73.6), (-3.2, -65.9)],
        ),
        (
