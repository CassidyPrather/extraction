    placements: [
        // Landmarks to steer by: two you can tell apart in sight from nearly
        // anywhere you walk (map_lint, "two landmarks in sight").
        // The machines' smelter stack behind the Gate: what they take, they melt.
        (prefab: "chimney", at: (-132.0, -169.1), rot: 0.0),
        // The pumping station's standpipe tower.
        (prefab: "water_tower", at: (-123.5, -17.3), rot: 0.0),
        // The quarantine checkpoint's incinerator stack, outside the gate:
