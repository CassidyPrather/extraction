// Rime Fell — the fifth Zone.
//
// A high, cold valley at the treeline's edge, 640 m on a side, climbing
// north the whole way. The truck stops in the Bottoms, among the last
// stunted spruce. Above, nothing grows: the switchback road climbs the
// west slope under its avalanche galleries, the funicular climbs straight
// up the middle, and both arrive at Coldharbour, the mining settlement on
// its bench, with the ore mill stepped down the slope east of it. Over the
// settlement the upper slopes are scree and old snow up to the col, the
// observatory on the north-west summit, and the cirque in the north-east
// where the machines come in by the frozen tarn. docs/FIFTH_VALLEY.md is
// the design.
//
//   North (-z)
//     the observatory on its summit and its saddle (RV) in the west; the
//     col (RV) in the middle; the cirque, the tarn (artifacts) and the
//     robot Gate in the east
//   Middle
//     the upper slopes (the crown hole, artifacts); Coldharbour on its
//     bench and the top station; the ore mill on the slope and the adit
//     over it; the tip road (RV) in the east
//   South (+z)
//     the switchbacks and their galleries in the west, the funicular in
//     the middle, the Bottoms and the south gate
//
// Coordinates: [x, z] metres, origin at centre, x east, +z south.
(
    name: "Rime Fell",
    description: "A high valley over the treeline: a mining settlement on its bench, the funicular up to it, the mill on the slope, scree and old snow to the col.",
    size: 640.0,
    cell: 1.0,
    base_height: 96.0,
    noise: (seed: 151, amplitude: 3.5, scale: 110.0, octaves: 5, detail: 0.25),
    rim: (width: 60.0, height: 14.0),
    fence_inset: 38.0,
    // Thin, clear, cold air.
    haze: Some((0.93, 0.98, 1.08)),
    // Up high in the wind you chill (docs/FIFTH_VALLEY.md, "Cold").
    cold: 1.0,
    sounds: (
        wind: "ambience/wind_mountain",
        birds: ["ambience/raven", "ambience/raven"],
        distant: ["ambience/rockfall"],
    ),

    features: [
        // The whole valley climbs north, steeply.
        Tilt(dir: (0.0, -1.0), rise_per_100m: 15.0),

        // The valley walls: high and bare.
        Ridge(points: [(-330.0, 330.0), (-300.0, 120.0), (-300.0, -120.0), (-330.0, -330.0)], width: 200.0, height: 40.0),
        Ridge(points: [(345.0, 330.0), (325.0, 100.0), (330.0, -140.0), (345.0, -330.0)], width: 190.0, height: 26.0),
        // The north-west summit the observatory stands on.
        Hill(at: (-212.0, -212.0), radius: 135.0, height: 20.0),
        // The cirque's back wall in the north-east, and the tarn's hollow
        // under it.
        Hill(at: (250.0, -310.0), radius: 110.0, height: 16.0),
        Hill(at: (170.0, -185.0), radius: 50.0, height: -6.0),
        // The knoll over the mill: the mine is in it, the mill stepped
        // down its south face.
        Hill(at: (150.0, -30.0), radius: 75.0, height: 7.0),
        // The Bottoms: a glacier's trough, scooped.
        Hill(at: (0.0, 205.0), radius: 150.0, height: -8.0),
        // Avalanche chutes off the west wall, across the switchbacks.
        Channel(points: [(-285.0, 20.0), (-210.0, 90.0), (-140.0, 175.0), (-110.0, 215.0)], width: 30.0, depth: 2.5),
        Channel(points: [(-290.0, 160.0), (-240.0, 200.0), (-200.0, 240.0)], width: 26.0, depth: 2.0),
        // The crown hole: the old stope fallen in, on the upper slopes.
        Hill(at: (-55.0, -115.0), radius: 22.0, height: -6.0),

        // Coldharbour's bench.
        Plateau(polygon: [(-120.0, -20.0), (40.0, -20.0), (40.0, 55.0), (-120.0, 55.0)], blend: 30.0),
        // The Gate's yard in the cirque.
        Plateau(polygon: [(200.0, -255.0), (232.0, -255.0), (232.0, -225.0), (200.0, -225.0)], height: Some(131.0), blend: 30.0),
        // The south gate's apron, at the road's height.
        Plateau(polygon: [(-34.0, 260.0), (14.0, 260.0), (14.0, 300.0), (-34.0, 300.0)], height: Some(51.5), blend: 16.0),
        // Where the truck turns: the saddle, the col, the tip road's end.
        Plateau(polygon: [(-130.0, -278.0), (-100.0, -278.0), (-100.0, -252.0), (-130.0, -252.0)], blend: 14.0),
        Plateau(polygon: [(55.0, -275.0), (85.0, -275.0), (85.0, -250.0), (55.0, -250.0)], blend: 14.0),
        Plateau(polygon: [(222.0, -42.0), (252.0, -42.0), (252.0, -14.0), (222.0, -14.0)], blend: 16.0),
        // The mill's terraces: one per level (4 m apart), falling south
        // down the knoll's face, each running out west past the mill's
        // side door to the mill steps.
        Plateau(polygon: [(114.0, 30.0), (156.0, 30.0), (156.0, 52.0), (114.0, 52.0)], height: Some(90.0), blend: 5.0),
        Plateau(polygon: [(114.0, 20.0), (156.0, 20.0), (156.0, 30.0), (114.0, 30.0)], height: Some(94.0), blend: 3.0),
        Plateau(polygon: [(114.0, 10.0), (156.0, 10.0), (156.0, 20.0), (114.0, 20.0)], height: Some(98.0), blend: 3.0),
        Plateau(polygon: [(114.0, -12.0), (160.0, -12.0), (160.0, 10.0), (114.0, 10.0)], height: Some(102.0), blend: 5.0),
    ],

    roads: [
        // In from the south gate, west along the Bottoms, then up the west
        // slope in switchbacks to Coldharbour, under the galleries where
        // the chutes cross it.
        (
            name: "Pass road", kind: Asphalt, width: 6.0, smoothing: 45.0,
            points: [(-10.0, 306.0), (-10.0, 266.0), (-60.0, 258.0), (-140.0, 245.0), (-205.0, 232.0),
                     (-228.0, 212.0), (-215.0, 192.0), (-150.0, 182.0), (-80.0, 170.0), (-58.0, 158.0),
                     (-66.0, 140.0), (-130.0, 128.0), (-200.0, 118.0), (-226.0, 100.0), (-212.0, 80.0),
                     (-150.0, 68.0), (-90.0, 52.0), (-40.0, 30.0)],
            galleries: [(at: (-150.0, 180.0), length: 44.0), (at: (-185.0, 121.0), length: 50.0)],
        ),
        // The funicular: track and service stair straight up the slope from
        // the valley station to the top station.
        (
            name: "Funicular", kind: Path, width: 5.0, shoulder: 2.0, smoothing: 90.0,
            points: [(62.0, 214.0), (60.0, 120.0), (58.0, 10.0)],
        ),
        // To the valley station.
        (
            name: "Station lane", kind: Dirt, width: 4.5, smoothing: 20.0,
            points: [(-10.0, 262.0), (30.0, 240.0), (62.0, 222.0)],
        ),
        // Coldharbour's street, from the road's end east to the top station
        // and on round the spur to the mill.
        (
            name: "Coldharbour street", kind: Gravel, width: 5.0, smoothing: 20.0,
            points: [(-40.0, 30.0), (0.0, 20.0), (58.0, 5.0), (95.0, 30.0), (122.0, 50.0), (140.0, 47.0)],
        ),
        // Round the knoll's east side from the mill's foot to its top and
        // the adit, and on east along the tip to the road's end.
        (
            name: "Mill road", kind: Dirt, width: 4.0, smoothing: 50.0,
            points: [(140.0, 47.0), (160.0, 50.0), (172.0, 32.0), (174.0, 8.0), (160.0, -6.0), (148.0, -20.0),
                     (152.0, -38.0), (180.0, -36.0), (205.0, -32.0), (232.0, -28.0)],
        ),
        // The mill steps: up the terraces past each level's side door.
        (
            name: "Mill steps", kind: Path, width: 2.0, shoulder: 1.5, smoothing: 100.0,
            points: [(100.0, 66.0), (104.0, 16.0), (104.0, -34.0)],
        ),
        // To the compressor house's door.
        (
            name: "Compressor lane", kind: Dirt, width: 3.5, smoothing: 15.0,
            points: [(222.0, -30.0), (232.0, -42.0), (240.0, -52.0)],
        ),
        // The mine track up the upper slopes to the col.
        (
            name: "Col track", kind: Dirt, width: 4.0, smoothing: 40.0,
            points: [(0.0, 20.0), (10.0, -40.0), (-10.0, -90.0), (20.0, -150.0), (5.0, -200.0), (40.0, -240.0), (70.0, -262.0)],
        ),
        // Along under the summit to the observatory's saddle.
        (
            name: "Saddle track", kind: Dirt, width: 3.5, smoothing: 40.0,
            points: [(5.0, -200.0), (-30.0, -235.0), (-70.0, -258.0), (-115.0, -264.0)],
        ),
        // The observatory path, up from the saddle.
        (
            name: "Observatory path", kind: Path, width: 1.8, shoulder: 1.5, smoothing: 50.0,
            points: [(-115.0, -264.0), (-150.0, -262.0), (-185.0, -250.0), (-204.0, -226.0)],
        ),
        // The old miners' path: straight up the west side from the
        // switchbacks' top over the upper slopes to the saddle.
        (
            name: "Miners' path", kind: Path, width: 1.8, shoulder: 1.5, smoothing: 45.0,
            points: [(-150.0, 68.0), (-150.0, 0.0), (-130.0, -80.0), (-110.0, -150.0), (-104.0, -170.0), (-105.0, -215.0), (-115.0, -264.0)],
        ),
        // The machines' track from the cirque down to the tarn and the
        // upper slopes.
        (
            name: "Gate track", kind: Dirt, width: 5.0, smoothing: 35.0,
            points: [(205.0, -238.0), (180.0, -232.0), (145.0, -218.0), (118.0, -180.0), (80.0, -150.0), (20.0, -150.0)],
        ),
    ],

    water: [
        // The tarn, frozen at its edges.
        (name: "The tarn", width: 32.0, depth: 1.6, points: [(155.0, -188.0), (182.0, -183.0)]),
    ],

    forests: [
        // The last trees: the Bottoms' stunted spruce, thinning up the
