         polygon: [(-282.0, 284.0), (-150.0, 284.0), (-120.0, 262.0), (-200.0, 248.0), (-282.0, 230.0)]),
        (name: "Bottoms spruce east", seed: 153, density: 0.8, undergrowth: 0.35,
