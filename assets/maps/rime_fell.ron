        (prefab: "rail_shed", at: (135.0, -42.0), rot: 90.0, tag: "adit_house"),

        // The tip road's end: the compressor house.
        (prefab: "pump_station", at: (240.0, -60.0), rot: 0.0, tag: "compressor_house"),

