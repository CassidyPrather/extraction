// The Training Yard — practice before the Zone.
//
// A small fenced valley, 240 m on a side, with nothing hunting in it (the
// game turns robots off here and saves nothing). A gravel track runs north
// from the truck past ten stations (`src/onboarding`: their posts, props
// and the training burner are placed there, not here): the kit, turning and crouching, putting
// it away, a far grab, the firing line, the house, first aid, the
// shimmer, a button, and calling the truck to the north post. Pull its
// cord to finish, or press the card by the tailgate to skip.
//
// Coordinates: [x, z] metres, origin at centre, x east, +z south.
(
    name: "Training Yard",
    description: "A fenced practice ground by the depot road.",
    size: 240.0,
    cell: 1.0,
    base_height: 12.0,
    noise: (seed: 31, amplitude: 1.2, scale: 90.0, octaves: 4, detail: 0.3),
    // The rim rises outside the perimeter fence (102 m out): the bays
    // inside stand on level ground, their fences on it.
    rim: (width: 18.0, height: 8.0),
    fence_inset: 18.0,

    features: [
        Hill(at: (55.0, -55.0), radius: 30.0, height: 5.0),
        // Low hummocks inside the bays, clear of their fences, the track
        // and the stations: not a mown meadow.
        Hill(at: (-20.0, 92.0), radius: 5.0, height: 0.7),
        Hill(at: (14.0, 30.0), radius: 5.0, height: 0.7),
        Hill(at: (8.0, -56.0), radius: 4.0, height: 0.6),
    ],

    roads: [
        (
            // Straight up the middle, through every bay's gate: 3 m, a
            // gate's leaf across.
            name: "Yard track", kind: Gravel, width: 3.0, smoothing: 10.0,
            points: [(0.0, 98.0), (0.0, 40.0), (0.0, -20.0), (0.0, -78.0)],
        ),
    ],

    forests: [
        (name: "West belt", seed: 5, density: 1.2, undergrowth: 0.5,
         mix: [(Spruce, 0.6), (Pine, 0.3), (Birch, 0.1)],
         polygon: [(-102.0, 102.0), (-70.0, 102.0), (-70.0, -102.0), (-102.0, -102.0)]),
        (name: "East belt", seed: 6, density: 1.0, undergrowth: 0.5,
         mix: [(Spruce, 0.5), (Birch, 0.5)],
         polygon: [(70.0, 102.0), (102.0, 102.0), (102.0, -102.0), (70.0, -102.0)]),
        (name: "North copse", seed: 7, density: 0.6, undergrowth: 0.4,
         mix: [(Pine, 0.7), (Birch, 0.3)],
         polygon: [(-60.0, -85.0), (60.0, -85.0), (60.0, -102.0), (-60.0, -102.0)]),
    ],

    placements: [
        // The wait by the truck at each rendezvous: a log pile 2.5-3.6 m off it,
        // to go still by while it comes (map_lint::WAIT_NEAR).
        (prefab: "log_pile", at: (5.6, -74.0), rot: 0.0, tag: "wait_north_post"),
        // The firing line: targets at 15, 30 and 60 m from the bench.
        (prefab: "target", at: (-12.0, 25.0), rot: 0.0),
        (prefab: "target", at: (-18.0, 10.0), rot: 0.0),
        (prefab: "target", at: (-10.0, -20.0), rot: 0.0),
        (prefab: "house_plank", at: (28.0, 18.0), rot: 270.0),
        (prefab: "shed", at: (24.0, -12.0), rot: 270.0),
        // Rooks on its roof (`onboarding::ROOKS_AT`): far enough from the
        // first station that walking leaves them be; run, and they go up.
        (prefab: "shed", at: (-30.0, 95.0), rot: 90.0),
        (prefab: "log_pile", at: (-12.0, -32.0), rot: 90.0),

        // Each gate line, and the range lane's side down bays 4-6, is a
        // board hoarding over a standing eye (playtest 22 November: "my line
        // of sight is completely unbroken"): a bay shows itself and, through
        // its gate, the next; not every lamp down the field.
        // The bays (#89, docs/YARD_SHAPE.md): bare timber fences, waist
        // high (world::yard), the next bay seen over them, and a gate on
        // the track in each, shut till its station's done or SKIPped.
        // The lane west of bays
        // 4-6 is the range's, out to its 60 m target; nothing in these
        // fences breaks, so it stops rounds.
        // Bay 1's back (south) fence, inside the yard's own.
