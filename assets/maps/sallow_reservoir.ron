        (kind: Loot(table: "tools"), at: (124.0, 42.0), name: "Drowned cottage"),
        // notes:begin (generated by scripts/place_notes.py)
        (kind: Note(text: "SOUTH GATE, SALLOW - DUTY LOG\n15 Oct. New Sallow out on the Marrow buses, second run. The old ones slow to board. One says they were moved for the water once already and once was enough.\n16 Oct. The keeper won't leave the works. Water board says let him, someone has to mind the dam.\n2 Nov. Something built on the north-east shore overnight. Not ours. Not the water board's."), at: (32.50, 284.40), rot: 153.4, name: "Sallow gate log"),
        (kind: Note(text: "Whoever has the cottage now -\nI was seven when the water board moved us up the hill. We watched the water come over the bridge a hand a day.\nThe second winter the machines opened the scours, and it went down a hand a day. On the twentieth day the church came out. Our house is the third from the bridge.\nDon't stand in the churchyard after rain. Things come up there that weren't buried.\n- A. Pech, keeper"), at: (-56.30, 206.80), rot: 295.2, name: "Keeper's note"),
        (kind: Terminal(pages: ["SALLOW WORKS - VALVE HOUSE\nVALVE LOG\n\nDRAW-OFF 1   SHUT    14 OCT\nDRAW-OFF 2   SHUT    14 OCT\nSUPPLY       NO DEMAND\n\nSCOUR 1      OPEN     2 DEC\nSCOUR 2      OPEN     2 DEC\nOPERATOR     NOT RECOGNISED", "LEVEL ABOVE BED (M)\n\n 1 DEC   31.4\n15 DEC   16.2\n29 DEC    4.1\n 5 JAN    0.6\n\nUPPER ARM   NO CHANGE\nCAUSEWAY    HOLDING"]), at: (6.20, 175.00), rot: -117.3, name: "Valve log"),
        (kind: Terminal(pages: ["SALLOW FILTER HOUSE\nDISTRICT SUPPLY (M3/DAY)\n\n         13 OCT  15 OCT  17 OCT\nMARROW    1840     210       0\nKETTLE    2210    1960       0\nCINDER    3930    3880       0", "CINDER WORKS\n\nDEMAND FROM    3 NOV\nFOR   FURNACE COOLING\nCEASED        26 FEB\n\nNO OTHER DEMAND."]), at: (97.00, 204.20), rot: -27.3, name: "Supply terminal"),
        (kind: Note(text: "CATCHWATER GAUGE - read Sundays\nSun. 0.42. Sun. 0.40. Sun. 0.41.\nSun. 0.12. They've cut it at the top. They want the bed dry and it's dry.\nSun. 0. Legs bad. Not coming up the hill again. A.P."), at: (242.00, -75.80), rot: 152.7, name: "Gauge book"),
        (kind: Note(text: "SALLOW ANGLING CLUB\nSeason closed until further notice, by order of the Quarantine Authority.\n(in pencil) Pike in the upper arm are the size of dogs now. Something's feeding them. Don't trail your hand."), at: (-159.37, 112.02), rot: 271.4, name: "Club notice"),
        (kind: Note(text: "CAUSEWAY TOLL\nFoot - free. Cart - 2. Motor - 5. New Sallow residents free (show card).\nCLOSED 14 OCT.\n(chalk) Culverts under the road are silted shut. The bed goes down, the arm comes up. Lower street's gone."), at: (-122.92, -113.32), rot: 145.3, name: "Toll board"),
        (kind: Terminal(pages: ["OVERFLOW STORE - SALLOW\nUNDER    DEPOT MARROW\nSTATUS   PENDING REVIEW\n\nBUSES              14\nBICYCLES          212\nREFUSE BINS       380\nPRAMS              31\n\nREVIEW DATE   (NOT SET)", "BUSES - DEPOT MARROW\n\nNO. 1-3     KEPT\nNO. 4       NOT RECOVERED\nNO. 5-9     KEPT", "BUSES - OTHER DEPOTS\n\nKETTLE         3   KEPT\nCINDER         3   KEPT\n\nSEARCH CONTINUES:\nMARROW NO. 4"]), at: (94.00, -82.00), rot: -90.0, name: "Stock terminal"),
        (kind: Note(text: "TOWER BOOK\n14 Oct. Both draw-offs shut, by order. Nobody downstream to drink it.\n2 Dec. The scours are opening by themselves. The wheels won't turn back. I've cut the chain off the big one and left it here.\nSomebody may want it shut again one day. - A.P."), at: (-21.00, 104.40), rot: 27.8, y: 20.0, name: "Tower book"),
        (kind: Note(text: "We were moved up here for the water, and now we're moved for this. Mrs Hlavac says she won't go twice. I've left her the shop key. Let her take what she needs.\n- J. Rybar, shop\n(another hand) She went in the end, in the spring, on her own feet. The shop's anyone's now. - A.P."), at: (-181.60, -222.40), rot: 104.0, name: "Shop note"),
        // notes:end
    ],

