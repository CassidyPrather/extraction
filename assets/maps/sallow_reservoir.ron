// Sallow Reservoir — the fourth Zone.
//
// The Authority's water works: a masonry dam across the narrows of a hill
// valley, 640 m on a side, and behind it the reservoir the machines
// drained. The truck stops below the dam; nothing is reached without
// getting over it. The bed behind is the most open ground in the game:
// silt, the old river, the drowned village, and the Custodian's stock in
// rows. The upper arm, held by the old causeway, is still full.
// docs/FOURTH_VALLEY.md is the design.
//
//   North (-z)
//     New Sallow, half flooded, and Sallow Head (RV) in the west; the
//     inflow bridge (RV) in the middle; the silt fans (artifacts) and the
//     robot Gate in the east
//   Middle
//     the drained bed: Old Sallow's ruins and church tower (artifacts in
//     the churchyard), the sorting ground's rows; the old causeway; the
//     catchwater's gauge house (RV) on the east hillside
//   South (+z)
//     the dam, its draw-off tower and spillway; below it the valve house,
//     the keeper's cottages, the filter house and the south gate
//
// Coordinates: [x, z] metres, origin at centre, x east, +z south.
(
    name: "Sallow Reservoir",
    description: "A dam across a hill valley, the reservoir behind it drained. Silt, a drowned village, and the machines' stock in rows.",
    size: 640.0,
    cell: 1.0,
    base_height: 39.0,
    noise: (seed: 83, amplitude: 2.5, scale: 120.0, octaves: 5, detail: 0.25),
    rim: (width: 70.0, height: 14.0),
    fence_inset: 38.0,
    // Cold, wet air off the water.
    haze: Some((0.92, 0.98, 1.06)),
    // Wind over the open bed and the crest; scree off the valley sides
    // (Audio's choice: the scours' drip and the arm's lapping to come).
    sounds: (
        wind: "ambience/wind_mountain",
        birds: ["ambience/crow", "ambience/raven"],
        distant: ["ambience/rockfall"],
    ),

    features: [
        // The valley climbs gently north, up the old river.
        Tilt(dir: (0.0, -1.0), rise_per_100m: 1.6),

        // The hillsides, west and east, and the arm's north shore.
        Ridge(points: [(-310.0, 320.0), (-290.0, 140.0), (-295.0, -60.0), (-320.0, -320.0)], width: 220.0, height: 28.0),
        Ridge(points: [(310.0, 320.0), (285.0, 140.0), (290.0, -40.0), (320.0, -320.0)], width: 200.0, height: 26.0),
        Ridge(points: [(-330.0, -300.0), (-150.0, -310.0), (0.0, -320.0)], width: 120.0, height: 8.0),

        // Below the dam: the valley the river runs out by.
        Channel(points: [(-20.0, 150.0), (-25.0, 220.0), (-35.0, 340.0)], width: 300.0, depth: 4.0),
        // The bed: the reservoir's floor, scoured flat.
        Channel(points: [(-30.0, 132.0), (-20.0, 0.0), (10.0, -150.0), (60.0, -260.0)], width: 320.0, depth: 2.0),
        // The old river's channel through the bed.
